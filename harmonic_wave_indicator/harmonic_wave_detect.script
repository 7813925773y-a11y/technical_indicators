// ═══════════════════════════════════════════════════════════════════════════════
//  PRZ ZONE CONSTRUCTION (Gartley)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  For Gartley, PRZ = min/max envelope of 4 projections:
//    1)  D at 0.786 retracement of XA
//    2)  D at 1.27  projection of BC (from C, opposite to C-B direction)
//    3)  D at 1.618 projection of BC
//    4)  D at AB=CD (CD leg equals AB leg, applied from C)
//
//  Outlier filtering: drop projections > 3 × ATR from the median.
//  Those projections are still stored (for display) but marked in_prz = false.
//  Confluence count = number of projections inside the final zone.
//
// ═══════════════════════════════════════════════════════════════════════════════

f_build_gartley_prz(Pivot pX, Pivot pA, Pivot pB, Pivot pC, bool bullish) =>
    array<Projection> projs = array.new<Projection>(0)

    // Projection 1: 0.786 retracement of XA
    float d_786 = f_FP(f_LP(pA.price) - 0.786 * (f_LP(pA.price) - f_LP(pX.price)))
    projs.push(Projection.new("0.786 XA", d_786, false))

    // Projection 2: 1.27 of BC — project D from C opposite to C-B direction
    float d_127 = f_FP(f_LP(pC.price) - 1.27 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("1.27 BC", d_127, false))

    // Projection 3: 1.618 of BC
    float d_1618 = f_FP(f_LP(pC.price) - 1.618 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("1.618 BC", d_1618, false))

    // Projection 4: AB=CD (CD leg has same price distance as AB leg)
    // ab_vec = log(B) - log(A) is the A→B vector. Apply to C: D = C + (B - A) in log space.
    float ab_vec = f_LP(pB.price) - f_LP(pA.price)
    float d_abcd = f_FP(f_LP(pC.price) + ab_vec)
    projs.push(Projection.new("AB=CD", d_abcd, false))

    // Compute median for outlier filtering
    array<float> prices = array.new<float>(0)
    for i = 0 to projs.size() - 1
        prices.push(projs.get(i).price)
    float med = array.median(prices)

    // Mark in_prz; build zone from inliers only
    float prz_top = na
    float prz_bot = na
    int   conf_count = 0
    for i = 0 to projs.size() - 1
        Projection p = projs.get(i)
        if math.abs(p.price - med) <= 3.0 * atr_v
            p.in_prz := true
            projs.set(i, p)
            conf_count += 1
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    // Fallback if all filtered out (should not happen in practice)
    if na(prz_top)
        for i = 0 to projs.size() - 1
            Projection p = projs.get(i)
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    PRZ.new(prz_top, prz_bot, projs, conf_count)


// ═══════════════════════════════════════════════════════════════════════════════
//  PRZ ZONE CONSTRUCTION (Bat)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  For Bat, PRZ projections:
//    1)  D at 0.886 retracement of XA
//    2)  D at 1.618 projection of BC
//    3)  D at 2.618 projection of BC
//    4)  D at AB=CD
//    5)  D at 1.27 AB=CD (extended AB=CD — Bat accepts either)
//
// ═══════════════════════════════════════════════════════════════════════════════

f_build_bat_prz(Pivot pX, Pivot pA, Pivot pB, Pivot pC, bool bullish) =>
    array<Projection> projs = array.new<Projection>(0)

    // 1) 0.886 retracement of XA
    float d_886 = f_FP(f_LP(pA.price) - 0.886 * (f_LP(pA.price) - f_LP(pX.price)))
    projs.push(Projection.new("0.886 XA", d_886, false))

    // 2) 1.618 projection of BC
    float d_1618 = f_FP(f_LP(pC.price) - 1.618 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("1.618 BC", d_1618, false))

    // 3) 2.618 projection of BC
    float d_2618 = f_FP(f_LP(pC.price) - 2.618 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("2.618 BC", d_2618, false))

    // 4) AB=CD
    float ab_vec = f_LP(pB.price) - f_LP(pA.price)
    float d_abcd = f_FP(f_LP(pC.price) + ab_vec)
    projs.push(Projection.new("AB=CD", d_abcd, false))

    // 5) 1.27 AB=CD
    float d_abcd_127 = f_FP(f_LP(pC.price) + 1.27 * ab_vec)
    projs.push(Projection.new("1.27 AB=CD", d_abcd_127, false))

    // Outlier filtering
    array<float> prices = array.new<float>(0)
    for i = 0 to projs.size() - 1
        prices.push(projs.get(i).price)
    float med = array.median(prices)

    float prz_top = na
    float prz_bot = na
    int   conf_count = 0
    for i = 0 to projs.size() - 1
        Projection p = projs.get(i)
        if math.abs(p.price - med) <= 3.0 * atr_v
            p.in_prz := true
            projs.set(i, p)
            conf_count += 1
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    if na(prz_top)
        for i = 0 to projs.size() - 1
            Projection p = projs.get(i)
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    PRZ.new(prz_top, prz_bot, projs, conf_count)


// ═══════════════════════════════════════════════════════════════════════════════
//  PRZ ZONE CONSTRUCTION (Alt Bat)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Alt Bat projects D BEYOND X. Projections:
//    1)  D at 1.13 extension of XA (past X)
//    2)  D at 2.0  projection of BC
//    3)  D at 3.618 projection of BC
//    4)  D at 1.27 AB=CD (Alt Bat requires extended AB=CD, not 1.0)
//
// ═══════════════════════════════════════════════════════════════════════════════

f_build_alt_bat_prz(Pivot pX, Pivot pA, Pivot pB, Pivot pC, bool bullish) =>
    array<Projection> projs = array.new<Projection>(0)

    // 1) 1.13 extension of XA — D beyond X
    float d_113 = f_FP(f_LP(pA.price) - 1.130 * (f_LP(pA.price) - f_LP(pX.price)))
    projs.push(Projection.new("1.13 XA", d_113, false))

    // 2) 2.0 projection of BC
    float d_200 = f_FP(f_LP(pC.price) - 2.000 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("2.0 BC", d_200, false))

    // 3) 3.618 projection of BC
    float d_3618 = f_FP(f_LP(pC.price) - 3.618 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("3.618 BC", d_3618, false))

    // 4) 1.27 AB=CD
    float ab_vec = f_LP(pB.price) - f_LP(pA.price)
    float d_abcd_127 = f_FP(f_LP(pC.price) + 1.27 * ab_vec)
    projs.push(Projection.new("1.27 AB=CD", d_abcd_127, false))

    // Outlier filtering
    array<float> prices = array.new<float>(0)
    for i = 0 to projs.size() - 1
        prices.push(projs.get(i).price)
    float med = array.median(prices)

    float prz_top = na
    float prz_bot = na
    int   conf_count = 0
    for i = 0 to projs.size() - 1
        Projection p = projs.get(i)
        if math.abs(p.price - med) <= 3.0 * atr_v
            p.in_prz := true
            projs.set(i, p)
            conf_count += 1
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    if na(prz_top)
        for i = 0 to projs.size() - 1
            Projection p = projs.get(i)
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    PRZ.new(prz_top, prz_bot, projs, conf_count)


// ═══════════════════════════════════════════════════════════════════════════════
//  PRZ ZONE CONSTRUCTION (Butterfly)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Butterfly projections:
//    1)  D at 1.272 extension of XA
//    2)  D at 1.618 projection of BC
//    3)  D at 2.618 projection of BC
//    4)  D at 1.27 AB=CD
//
// ═══════════════════════════════════════════════════════════════════════════════

f_build_butterfly_prz(Pivot pX, Pivot pA, Pivot pB, Pivot pC, bool bullish) =>
