//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Harmonic Auto-Validator [GBB] — v1.1
// ─────────────────────────────────────────────────────────────────────────────
//  Author:   The Good, the Bad and the Bitcoin
//  License:  © All rights reserved. Subject to TradingView's Terms of Service.
//
//  v1.1 CHANGES
//  ────────────
//  Adds Forming Mode (opt-in). Projects the PRZ from X/A/B/C before D prints,
//  exposing the canonical Carney workflow of pre-placing limit orders at the
//  projected reversal zone rather than waiting for D confirmation. Forming
//  patterns render with dotted legs, a (F) prefix, and DO NOT trigger alerts.
//  Off by default to preserve the v1.0 confirmed-only experience for new users.
//
//  WHAT IT DOES
//  ────────────
//  HAV detects harmonic price patterns with strict adherence to Scott Carney's
//  methodology. Every detection includes a Potential Reversal Zone (PRZ) computed
//  as the convergence envelope of multiple Fibonacci projections, an embedded
//  AB=CD validation check, and a 0-10 quality score combining ratio precision,
//  zone tightness, and projection confluence.
//
//  PATTERNS DETECTED
//  ─────────────────
//    • Gartley     (retrace,   D between X and A, B≈0.618 / D≈0.786)
//    • Bat         (retrace,   D between X and A, B≈0.500 / D≈0.886)
//    • Alt Bat     (extension, D beyond X,        B≈0.382 / D≈1.130)
//    • Butterfly   (extension, D beyond X,        B≈0.786 / D≈1.272)
//    • Crab        (extension, D beyond X,        B≈0.500 / D≈1.618)
//    • Deep Crab   (extension, D beyond X,        B≈0.886 / D≈1.618)
//
//  WHAT MAKES IT DIFFERENT
//  ───────────────────────
//    1. PRZ rendered as a ZONE, not a single line. Most indicators show D as a
//       single Fibonacci level. Carney's methodology defines D as a zone where
//       multiple projections converge. HAV computes that zone with outlier
//       filtering and shows it.
//
//    2. Embedded AB=CD validation. Carney requires that an AB=CD projection
//       falls within the PRZ for the pattern to be high-conviction. HAV checks
//       this and applies a -2 score penalty when the AB=CD does not converge,
//       displaying a ⚠ warning glyph on the pattern label.
//
//    3. Confirmed-only display by default. No projected/forming patterns that
//       might disappear later. When HAV draws a pattern, it has fully validated.
//
//    4. Quality scoring (0-10) combining ratio precision, PRZ tightness vs ATR,
//       and number of projections in confluence. Patterns scoring below the
//       configurable threshold are filtered, not displayed.
//
//    5. Borderline mode: opt-in display of patterns scoring 4.0-5.9 (below the
//       confirmation threshold) with dashed legs and "(B)" prefix. Useful for
//       educational context and confluence with other tools. Borderline patterns
//       do NOT trigger alerts — alerts remain reserved for confirmed signals.
//
//  ALERT DELIVERY
//  ──────────────
//    • Unified alert() with structured JSON payload — for webhook integrations
//      with Telegram bots, Discord, Slack, custom platforms.
//    • 12 named alertcondition() entries (bullish/bearish × 6 patterns) — for
//      native TradingView alert UI without webhook infrastructure.
//
//  HONEST EXPECTATIONS
//  ───────────────────
//  Harmonic patterns are rare on any single chart. Expect roughly:
//    • 1-4 patterns per year on Daily timeframe
//    • 5-15 patterns per month on 4H
//    • 20-50 patterns per week on lower timeframes (5m/15m)
//
//  HAV is a CONFLUENCE / VERIFICATION tool, not a high-frequency signal generator.
//  Best deployed across many instruments and timeframes simultaneously, with
//  alert delivery routing detected patterns to a single notification stream.
//
// ═══════════════════════════════════════════════════════════════════════════════

indicator("Harmonic Auto-Validator [GBB]",
     shorttitle        = "HAV",
     overlay           = true,
     max_lines_count   = 500,
     max_labels_count  = 500,
     max_boxes_count   = 500)

// HAV v1.1 — Forming Mode opt-in


// ═══════════════════════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// ── Pattern Selection ──────────────────────────────────────────────────────────
g_pat = "▼ Pattern Selection"
i_scan_gartley = input.bool(true, "Gartley",
     group   = g_pat,
     tooltip = "Classic Gartley: B=0.618 XA, D=0.786 XA, embedded AB=CD required.")
i_scan_bat = input.bool(true, "Bat",
     group   = g_pat,
     tooltip = "Bat: B=0.382-0.500 XA, D=0.886 XA, embedded AB=CD or 1.27 AB=CD required.")
i_scan_alt_bat = input.bool(true, "Alternate Bat",
     group   = g_pat,
     tooltip = "Alt Bat: B≤0.382 XA (shallow retrace), D=1.13 XA (D extends BEYOND X), 1.27 AB=CD required.")
i_scan_butterfly = input.bool(true, "Butterfly",
     group   = g_pat,
     tooltip = "Butterfly: B=0.786 XA, D=1.272 XA (extension beyond X), 1.27 AB=CD convergent.")
i_scan_crab = input.bool(true, "Crab",
     group   = g_pat,
     tooltip = "Crab: B=0.382-0.618 XA, D=1.618 XA (deep extension beyond X), 1.27 AB=CD convergent.")
i_scan_deep_crab = input.bool(true, "Deep Crab",
     group   = g_pat,
     tooltip = "Deep Crab: B=0.886 XA, D=1.618 XA (deep extension beyond X), 1.27 AB=CD convergent.")

// ── Alerts ─────────────────────────────────────────────────────────────────────
g_alert = "▼ Alerts"
i_enable_alerts = input.bool(true, "Enable Alerts",
     group   = g_alert,
     tooltip = "Master toggle for the unified alert() call. When ON, the indicator " +
               "fires a JSON alert whenever any pattern is confirmed. Use this with " +
               "TradingView's alert UI (event = 'Any alert() function call'). " +
               "The 12 named alertcondition() entries are always available regardless.")
i_alert_min_score = input.float(6.0, "Minimum Score for Alert", minval=0.0, maxval=10.0, step=0.5,
     group   = g_alert,
     tooltip = "Patterns scoring below this threshold will be drawn but will NOT trigger " +
               "the unified alert. Set higher (e.g., 7.0) to filter for higher-conviction " +
               "patterns when scanning many charts.")

// ── Display Mode ───────────────────────────────────────────────────────────────
g_dmode = "▼ Display Mode"
i_show_borderline = input.bool(false, "Show Borderline Patterns",
     group   = g_dmode,
     tooltip = "When ON, patterns that pass all ratio gates but score between " +
               "the borderline threshold and the confirmation threshold are drawn " +
               "with reduced opacity and dashed legs. Useful for: educational " +
               "context, confluence with other tools, and seeing the indicator " +
               "produce more on-chart output between confirmed patterns. " +
               "Borderline patterns do NOT trigger alerts — alerts remain reserved " +
               "for confirmed patterns only.")
i_borderline_min_score = input.float(4.0, "Borderline Min Score",
     minval=0.0, maxval=10.0, step=0.5,
     group   = g_dmode,
     tooltip = "Lower bound for borderline display. Patterns scoring between this " +
               "value and the main 'Min Score' are shown as borderline. Default 4.0 " +
               "captures meaningful runners-up; lowering toward 0 will surface very " +
               "weak patterns and may clutter the chart.")

// ── Forming Mode (advanced) ────────────────────────────────────────────────────
g_form = "▼ Forming Mode (advanced)"
i_show_forming = input.bool(false, "Show Forming Patterns",
     group   = g_form,
     tooltip = "When ON, projects PRZ zones from X/A/B/C BEFORE D prints. Forming " +
               "patterns render with dotted legs and a (F) prefix and use a 0-8 score " +
               "scale (since AB=CD convergence and D ratio precision can't be checked " +
               "without D). DO NOT trigger alerts — alerts remain reserved for confirmed " +
               "patterns. Useful for setting up limit orders at projected reversal zones " +
               "(canonical Carney workflow). Off by default.")
i_forming_min_score = input.float(4.0, "Forming Min Score",
     minval=0.0, maxval=8.0, step=0.5,
     group   = g_form,
     tooltip = "Forming patterns score 0-8 (vs 0-10 for confirmed) since AB=CD " +
               "convergence and D ratio precision can't be checked without D. Patterns " +
               "scoring below this threshold are filtered. Default 4.0 surfaces meaningful " +
               "anticipatory setups without flooding the chart.")
i_forming_max_bars = input.int(0, "Forming Time Decay (bars, 0=auto)",
     minval=0, maxval=500,
     group   = g_form,
     tooltip = "Forming pattern auto-deletes after this many bars without D printing. " +
               "0 = auto (5 × pivot length, so 65 bars on Daily). Set higher to keep " +
               "patterns visible longer; lower to clean up faster.")
i_forming_max_atr = input.float(3.0, "Forming Distance Decay (ATR multiples)",
     minval=1.0, maxval=10.0, step=0.5,
     group   = g_form,
     tooltip = "Forming pattern auto-deletes if price moves this many ATR units away " +
               "from the PRZ in the wrong direction. Catches patterns where price action " +
               "invalidates the thesis quickly.")
i_show_failed = input.bool(true, "Show Failed Forming Patterns",
     group   = g_form,
     tooltip = "When a forming pattern's D prints but doesn't validate the full ratio " +
               "gates, briefly show with X marker before auto-removing. Educational — " +
               "shows which forming setups didn't work out. Does NOT affect alerts or " +
               "the indicator's signal quality.")

// ── Pivot Detection ────────────────────────────────────────────────────────────
g_piv = "▼ Pivot Detection"
i_len_mode = input.string("Auto (Fibonacci by TF)", "Zigzag Length",
     options = ["Auto (Fibonacci by TF)", "Manual"],
     group   = g_piv,
     tooltip = "Auto: 5 for ≤30m, 8 for 1H-4H, 13 for D, 21 for W. Manual: set below.")
i_len_manual = input.int(8, "Manual Length", minval=2, maxval=50, group=g_piv)
i_min_xa_atr = input.float(2.0, "Min XA Distance (ATR multiples)",
     minval  = 0.5,
     step    = 0.1,
     group   = g_piv,
     tooltip = "Reject patterns where the XA leg is smaller than N × ATR (noise filter).")

// ── Validation ─────────────────────────────────────────────────────────────────
g_val = "▼ Validation"
i_preset = input.string("Standard", "Tolerance Preset",
     options = ["Strict", "Standard", "Lenient"],
     group   = g_val,
     tooltip = "Controls how much deviation from Carney's ideal Fibonacci ratios " +
               "is accepted. Strict: ±0.020 around each ideal — only near-perfect " +
               "patterns. Standard: ±0.060 — recommended starting point. Lenient: " +
               "±0.100 — surfaces more patterns at the cost of geometric purity. " +
               "If you're seeing too few patterns on your charts, try Lenient first.")
i_penalize_no_abcd = input.bool(true, "Penalize Non-Convergent AB=CD",
     group   = g_val,
     tooltip = "If ON: patterns whose internal AB=CD projection doesn't land inside " +
               "the PRZ get a -2 score penalty. If OFF: warning ⚠ icon shown but no " +
               "score impact. Carney considers AB=CD convergence essential to a " +
               "high-conviction pattern.")

// ── PRZ & Scoring ──────────────────────────────────────────────────────────────
g_sco = "▼ PRZ & Scoring"
i_min_score = input.int(6, "Minimum Score (0-10)",
     minval  = 0,
     maxval  = 10,
     group   = g_sco,
     tooltip = "Patterns scoring below this threshold are suppressed entirely. " +
               "The 0-10 score combines ratio precision, PRZ tightness vs ATR, " +
               "and projection confluence count. Recommended: 6. Lower to 4-5 to " +
               "see more borderline patterns; raise to 7-8 to filter for only the " +
               "highest-conviction setups.")
i_min_conf = input.int(2, "Min Confluence Count",
     minval  = 0,
     maxval  = 5,
     group   = g_sco,
     tooltip = "Minimum number of Fibonacci projections that must land inside the " +
               "final PRZ zone for the pattern to be valid. Each pattern type uses " +
               "4-5 projections (e.g., Gartley uses 0.786 XA + 1.27 BC + 1.618 BC + " +
               "AB=CD). Default 2 strikes a balance between strictness and detection " +
               "rate.")
i_log_mode = input.string("Off", "Log Scale",
     options = ["Auto", "On", "Off"],
     group   = g_sco,
     tooltip = "Affects all Fibonacci math. A linear Gartley with AB=0.618 of XA " +
               "measures ~0.591 in log space, so log mode uses different (narrower) " +
               "patterns than visual/linear convention. Off = matches Carney's classic " +
               "books and is recommended for most use cases. Auto = on for crypto.")

// ── Volatility Filter ─────────────────────────────────────────────────────────
g_risk = "▼ Volatility Filter"
i_atr_period = input.int(14, "ATR Period", minval=1, group=g_risk,
     tooltip = "ATR length used for the XA-leg noise filter. Lower values are more " +
               "responsive to recent volatility; higher values are more stable across regimes.")

// ── Display ────────────────────────────────────────────────────────────────────
g_disp = "▼ Display"
i_clean = input.bool(false, "Clean Display (minimal labels)", group=g_disp)
i_show_pat_label = input.bool(true,  "Show Pattern Name + Score", group=g_disp)
i_show_ratio_labels = input.bool(true, "Show Ratio Labels on Legs", group=g_disp)
i_show_pivot_labels = input.bool(true, "Show Pivot Labels (X/A/B/C/D)", group=g_disp)
i_show_pivot_markers = input.bool(true, "Show Pivot Markers (zigzag dots)",
     group   = g_disp,
     tooltip = "Plots small triangle markers above/below all detected pivots " +
               "(not just pivots in confirmed patterns). Useful for visualizing " +
               "the zigzag the indicator is using internally.")
i_show_projections = input.bool(false, "Show PRZ Projection Lines",
     group   = g_disp,
     tooltip = "Draws each individual PRZ projection (0.786 XA, 1.27 BC, 1.618 BC, " +
               "AB=CD, etc.) as dashed lines. Verbose — off by default.")
i_color_bull = input.color(#26A69A, "Bullish Color", group=g_disp)
i_color_bear = input.color(#EF5350, "Bearish Color", group=g_disp)
i_color_warn = input.color(#FFB300, "Warning Color (AB=CD Non-Convergence)", group=g_disp)

// ── Maintenance ────────────────────────────────────────────────────────────────
g_maint = "▼ Maintenance"
i_max_active = input.int(30, "Max Stored Patterns", minval=5, maxval=100,
     group   = g_maint,
     tooltip = "Upper bound on pattern array size to prevent memory bloat. Old patterns are FIFO-evicted.")

// ── Diagnostics (advanced) ─────────────────────────────────────────────────────
g_diag = "▼ Diagnostics (advanced)"
i_show_diagnostics = input.bool(true, "Show Diagnostics Table",
     group   = g_diag,
     tooltip = "Displays a debug table in the top-right with detection statistics: " +
               "windows tested, per-gate rejection counts, ratio distributions, and " +
               "pattern acceptance breakdown. ON by default — the diagnostics are part " +
               "of HAV's transparency: you can see exactly how many candidates were " +
               "evaluated and where they were filtered. Toggle off if it clutters " +
               "your chart.")
i_show_distribution = input.bool(false, "Show Distribution Stats (advanced)",
     group   = g_diag,
     tooltip = "Adds 4 extra rows to the diagnostics table showing the min/avg/max " +
               "distribution of r_AB and r_XD ratios across all candidates that " +
               "passed structure/XA gates, plus the closest-to-ideal Gartley candidate. " +
               "Useful for understanding the asset's natural retracement profile " +
               "(e.g., crypto tends toward Bat-shaped ratios, forex toward Gartley). " +
               "OFF by default — primarily for advanced users and tolerance calibration.")


// ═══════════════════════════════════════════════════════════════════════════════
//  USER-DEFINED TYPES
// ═══════════════════════════════════════════════════════════════════════════════

type Pivot
    int   t       = 0       // bar time
    float price   = 0.0
    int   bi      = 0       // bar_index
    bool  isHigh  = false

type Projection
    string label  = ""
    float  price  = 0.0
    bool   in_prz = false

type PRZ
    float top = 0.0
    float bot = 0.0
    array<Projection> projections = na
    int   confluence_count = 0

type HarmonicPattern
    string pattern_type   = ""
    bool   is_bullish     = false
    Pivot  pX             = na
    Pivot  pA             = na
    Pivot  pB             = na
    Pivot  pC             = na
    Pivot  pD             = na
    PRZ    prz            = na
    float  score          = 0.0
    bool   abcd_converges = false
    // State: "Confirmed", "Borderline", "Forming", "Failed"
    // (Stale patterns are deleted from the array, not kept with this state)
    string state          = "Confirmed"
    // Computed ratios (for display); r_CD/r_XD are 0.0 for Forming patterns
    float  r_AB           = 0.0
    float  r_BC           = 0.0
    float  r_CD           = 0.0
    float  r_XD           = 0.0
    // Forming-mode lifecycle tracking
    int    forming_c_bar  = 0     // bar index of C confirmation (used for time-decay)
    int    failed_at_bar  = 0     // bar index when pattern transitioned to Failed (for fade-out)
    // Drawing object references (for future cleanup)
    array<line>  lines    = na
    array<label> labels   = na
    array<box>   boxes    = na


// ═══════════════════════════════════════════════════════════════════════════════
//  UTILITIES
// ═══════════════════════════════════════════════════════════════════════════════

// ── Auto zigzag length by timeframe ────────────────────────────────────────────
f_auto_length() =>
    int tf_mins = timeframe.in_seconds(timeframe.period) / 60
    tf_mins <= 30   ?  5 :
     tf_mins <= 240  ?  8 :
     tf_mins <= 1440 ? 13 :
                       21

int length_eff = i_len_mode == "Manual" ? i_len_manual : f_auto_length()

// ── Log-scale toggle ───────────────────────────────────────────────────────────
bool use_log = i_log_mode == "On" or (i_log_mode == "Auto" and syminfo.type == "crypto")

// Log-aware price transforms. In log mode, all Fibonacci math operates in log-space.
f_LP(float p) => use_log ? math.log(p) : p
f_FP(float p) => use_log ? math.exp(p) : p

// Compute a retracement ratio:  |anchor_far - point| / |anchor_far - anchor_near|
// This is the canonical "how much of the leg has this point retraced from anchor_far."
f_retrace_ratio(float anchor_far, float anchor_near, float point) =>
    float af = f_LP(anchor_far)
    float an = f_LP(anchor_near)
    float pp = f_LP(point)
    math.abs(af - pp) / math.abs(af - an)

// ── Indicators ─────────────────────────────────────────────────────────────────
float atr_v = ta.atr(i_atr_period)

// ── Tolerance presets (Gartley) ────────────────────────────────────────────────
// Each returns a tuple [low, high] bounding the acceptable ratio range for the preset.
// The Standard preset uses Carney's published ranges. Strict narrows; Lenient widens.

// ── Gartley Tolerance Bands by Preset ──────────────────────────────────────────
// Each returns a tuple [low, high] bounding the acceptable ratio range for the preset.

f_gart_tol_B(bool strict, bool lenient) =>    // AB as retrace of XA, ideal 0.618
    // Centered on 0.618. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    float lo = strict ? 0.598 : lenient ? 0.518 : 0.558
    float hi = strict ? 0.638 : lenient ? 0.718 : 0.678
    [lo, hi]

f_gart_tol_BC(bool strict, bool lenient) =>   // BC as retrace of AB
    float lo = strict ? 0.382 : lenient ? 0.300 : 0.382
    float hi = strict ? 0.886 : lenient ? 0.950 : 0.886
    [lo, hi]

f_gart_tol_CD(bool strict, bool lenient) =>   // CD as projection of BC
    float lo = strict ? 1.130 : lenient ? 1.000 : 1.130
    float hi = strict ? 1.618 : lenient ? 1.800 : 1.618
    [lo, hi]

f_gart_tol_D(bool strict, bool lenient) =>    // D as retrace of XA, ideal 0.786
    // Centered on 0.786. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    float lo = strict ? 0.766 : lenient ? 0.686 : 0.726
    float hi = strict ? 0.806 : lenient ? 0.886 : 0.846
    [lo, hi]

// ── Bat Tolerance Bands by Preset ──────────────────────────────────────────────
// Ideal B=0.500, D=0.886. Same structural family as Gartley (D between X and A).

f_bat_tol_B(bool strict, bool lenient) =>     // AB as retrace of XA, ideal 0.500
    // Centered on 0.500. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    // Carney's B range is 0.382-0.500; we treat 0.500 as ideal and allow symmetric deviation.
    float lo = strict ? 0.480 : lenient ? 0.400 : 0.440
    float hi = strict ? 0.520 : lenient ? 0.600 : 0.560
    [lo, hi]

f_bat_tol_BC(bool strict, bool lenient) =>    // BC as retrace of AB (same range as Gartley)
    float lo = strict ? 0.382 : lenient ? 0.300 : 0.382
    float hi = strict ? 0.886 : lenient ? 0.950 : 0.886
    [lo, hi]

f_bat_tol_CD(bool strict, bool lenient) =>    // CD as projection of BC, range 1.618-2.618
    float lo = strict ? 1.618 : lenient ? 1.500 : 1.618
    float hi = strict ? 2.618 : lenient ? 2.900 : 2.618
    [lo, hi]

f_bat_tol_D(bool strict, bool lenient) =>     // D as retrace of XA, ideal 0.886
    // Centered on 0.886. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    float lo = strict ? 0.866 : lenient ? 0.786 : 0.826
    float hi = strict ? 0.906 : lenient ? 0.986 : 0.946
    [lo, hi]

// ── Alt Bat Tolerance Bands by Preset ──────────────────────────────────────────
// Ideal B=0.382, D=1.130. NOTE: D at 1.13 XA means D EXTENDS BEYOND X — this is
// a different structural family from Gartley/Bat where D sits between X and A.

f_abat_tol_B(bool strict, bool lenient) =>    // AB as retrace of XA, ideal 0.382
    // Centered on 0.382. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    float lo = strict ? 0.362 : lenient ? 0.282 : 0.322
    float hi = strict ? 0.402 : lenient ? 0.482 : 0.442
    [lo, hi]

f_abat_tol_BC(bool strict, bool lenient) =>   // BC as retrace of AB (same range as others)
    float lo = strict ? 0.382 : lenient ? 0.300 : 0.382
    float hi = strict ? 0.886 : lenient ? 0.950 : 0.886
    [lo, hi]

f_abat_tol_CD(bool strict, bool lenient) =>   // CD as projection of BC, range 2.0-3.618
    // Alt Bat has deep CD extensions. Strict keeps Carney's range tight; Lenient widens.
    float lo = strict ? 2.200 : lenient ? 1.618 : 2.000
    float hi = strict ? 3.400 : lenient ? 4.000 : 3.618
    [lo, hi]

f_abat_tol_D(bool strict, bool lenient) =>    // D as extension of XA, ideal 1.130
    // Centered on 1.130. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    float lo = strict ? 1.110 : lenient ? 1.030 : 1.070
    float hi = strict ? 1.150 : lenient ? 1.230 : 1.190
    [lo, hi]

// ── Butterfly Tolerance Bands by Preset ────────────────────────────────────────
// Ideal B=0.786, D=1.272. Extension family — D BEYOND X.

f_bfly_tol_B(bool strict, bool lenient) =>    // AB as retrace of XA, ideal 0.786
    // Centered on 0.786. Same tolerance philosophy as Gartley D band.
    float lo = strict ? 0.766 : lenient ? 0.686 : 0.726
    float hi = strict ? 0.806 : lenient ? 0.886 : 0.846
    [lo, hi]

f_bfly_tol_BC(bool strict, bool lenient) =>   // BC as retrace of AB (same range as others)
    float lo = strict ? 0.382 : lenient ? 0.300 : 0.382
    float hi = strict ? 0.886 : lenient ? 0.950 : 0.886
    [lo, hi]

f_bfly_tol_CD(bool strict, bool lenient) =>   // CD as projection of BC, range 1.618-2.618
    float lo = strict ? 1.618 : lenient ? 1.500 : 1.618
    float hi = strict ? 2.618 : lenient ? 2.900 : 2.618
    [lo, hi]

f_bfly_tol_D(bool strict, bool lenient) =>    // D as extension of XA, ideal 1.272
    // Centered on 1.272. Strict ±0.020, Standard ±0.060, Lenient ±0.100.
    float lo = strict ? 1.252 : lenient ? 1.172 : 1.212
    float hi = strict ? 1.292 : lenient ? 1.372 : 1.332
    [lo, hi]

// ── Crab Tolerance Bands by Preset ─────────────────────────────────────────────
// Ideal B=0.500, D=1.618. Extension family — D BEYOND X (deeper than Butterfly).
// B range in Carney is 0.382-0.618; we treat 0.500 as ideal with symmetric tolerance.

f_crab_tol_B(bool strict, bool lenient) =>    // AB as retrace of XA, ideal 0.500
    float lo = strict ? 0.480 : lenient ? 0.400 : 0.440
    float hi = strict ? 0.520 : lenient ? 0.618 : 0.560
    [lo, hi]

f_crab_tol_BC(bool strict, bool lenient) =>   // BC as retrace of AB
    float lo = strict ? 0.382 : lenient ? 0.300 : 0.382
    float hi = strict ? 0.886 : lenient ? 0.950 : 0.886
    [lo, hi]

f_crab_tol_CD(bool strict, bool lenient) =>   // CD as projection of BC, range 2.618-3.618
    // Crab has the deepest CD extensions of all patterns.
    float lo = strict ? 2.618 : lenient ? 2.400 : 2.618
    float hi = strict ? 3.618 : lenient ? 4.000 : 3.618
    [lo, hi]

f_crab_tol_D(bool strict, bool lenient) =>    // D as extension of XA, ideal 1.618
    // Centered on 1.618.
    float lo = strict ? 1.598 : lenient ? 1.518 : 1.558
    float hi = strict ? 1.638 : lenient ? 1.718 : 1.678
    [lo, hi]

// ── Deep Crab Tolerance Bands by Preset ────────────────────────────────────────
// Ideal B=0.886, D=1.618. Distinguished from Crab solely by B ratio.

f_dcrab_tol_B(bool strict, bool lenient) =>   // AB as retrace of XA, ideal 0.886
    // Centered on 0.886.
    float lo = strict ? 0.866 : lenient ? 0.786 : 0.826
    float hi = strict ? 0.906 : lenient ? 0.986 : 0.946
    [lo, hi]

f_dcrab_tol_BC(bool strict, bool lenient) =>  // BC as retrace of AB
    float lo = strict ? 0.382 : lenient ? 0.300 : 0.382
    float hi = strict ? 0.886 : lenient ? 0.950 : 0.886
    [lo, hi]

f_dcrab_tol_CD(bool strict, bool lenient) =>  // CD as projection of BC, same as Crab
    float lo = strict ? 2.618 : lenient ? 2.400 : 2.618
    float hi = strict ? 3.618 : lenient ? 4.000 : 3.618
    [lo, hi]

f_dcrab_tol_D(bool strict, bool lenient) =>   // D as extension of XA, ideal 1.618 (same as Crab)
    float lo = strict ? 1.598 : lenient ? 1.518 : 1.558
    float hi = strict ? 1.638 : lenient ? 1.718 : 1.678
    [lo, hi]

bool strict  = i_preset == "Strict"
bool lenient = i_preset == "Lenient"


// ═══════════════════════════════════════════════════════════════════════════════
//  PIVOT DETECTION (single zigzag, strict alternation)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  ta.pivothigh/low confirm `length_eff` bars after the pivot occurred.
//  When a new pivot prints, we either:
//    (a) append to the buffer if opposite direction to the last pivot, or
//    (b) update-in-place if same direction AND more extreme than the last pivot.
//  This enforces strict alternation: high → low → high → low.
//
//  Once a pivot has an opposite-direction pivot after it in the buffer, it is
//  "locked in" and cannot be updated anymore. Pattern detection only considers
//  locked pivots (positions 0..n-2 in the buffer), never the latest entry.
//
// ═══════════════════════════════════════════════════════════════════════════════

var array<Pivot> pivot_buf = array.new<Pivot>(0)

f_push_pivot(Pivot p) =>
    if pivot_buf.size() == 0
        pivot_buf.push(p)
    else
        Pivot last = pivot_buf.get(pivot_buf.size() - 1)
        if last.isHigh == p.isHigh
            // Same direction — keep the more extreme pivot
            bool more_extreme = p.isHigh ? p.price > last.price : p.price < last.price
            if more_extreme
                pivot_buf.set(pivot_buf.size() - 1, p)
        else
            pivot_buf.push(p)
    // Trim buffer (keep last 12)
    while pivot_buf.size() > 12
        pivot_buf.shift()

float piv_h = ta.pivothigh(length_eff, length_eff)
float piv_l = ta.pivotlow(length_eff, length_eff)

// Track new-pivot events by watching the bar_index of the last pivot in the buffer.
// This catches both (a) new pivots pushed, and (b) last pivot updated in place.
// Watching buffer SIZE fails once the buffer caps at 12 (push+shift = net 0 change).
var int last_pivot_bi = -1

if not na(piv_h)
    Pivot p_new = Pivot.new(time[length_eff], piv_h, bar_index[length_eff], true)
    f_push_pivot(p_new)

if not na(piv_l)
    Pivot p_new = Pivot.new(time[length_eff], piv_l, bar_index[length_eff], false)
    f_push_pivot(p_new)

int  cur_last_bi     = pivot_buf.size() > 0 ? pivot_buf.get(pivot_buf.size() - 1).bi : -1
bool new_pivot_added = cur_last_bi != last_pivot_bi
last_pivot_bi := cur_last_bi


// ═══════════════════════════════════════════════════════════════════════════════
//  GARTLEY VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Given 5 consecutive pivots forming a candidate XABCD, validate the Gartley
//  structural and ratio constraints. Returns [valid, bullish, r_AB, r_BC, r_CD, r_XD].
//
//  Ratios:
//    r_AB = |A - B| / |A - X|   (AB as retrace of XA, ideal 0.618)
//    r_BC = |B - C| / |B - A|   (BC as retrace of AB, range 0.382-0.886)
//    r_CD = |C - D| / |C - B|   (CD as projection of BC, range 1.13-1.618)
//    r_XD = |A - D| / |A - X|   (D location as retrace of XA, ideal 0.786)
//
// ═══════════════════════════════════════════════════════════════════════════════

//
//  Returns [status, bullish, r_AB, r_BC, r_CD, r_XD] where status codes are:
//    0 = valid
//    1 = direction alternation failed
//    2 = structural ordering failed
//    3 = XA leg too small (below ATR threshold)
//    4 = AB ratio out of band
//    5 = BC ratio out of band
//    6 = CD ratio out of band
//    7 = XD ratio out of band
//
// ═══════════════════════════════════════════════════════════════════════════════

f_validate_gartley(Pivot pX, Pivot pA, Pivot pB, Pivot pC, Pivot pD) =>
    // Direction alternation check
    bool dir_ok = (pX.isHigh != pA.isHigh) and
                  (pA.isHigh != pB.isHigh) and
                  (pB.isHigh != pC.isHigh) and
                  (pC.isHigh != pD.isHigh)
    bool bullish = not pX.isHigh    // X is a low → bullish Gartley (M-shape inverted)

    // Structural ordering: for bullish, X<A, X<B<A, B<C<A, X<D<C
    bool struct_ok = false
    if bullish
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price and
                     pD.price > pX.price and pD.price < pC.price
    else
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price and
                     pD.price < pX.price and pD.price > pC.price

    // Noise filter: XA must be at least N × ATR
    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0
    float r_CD   = 0.0
    float r_XD   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        // Compute ratios (log-aware)
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        r_CD := f_retrace_ratio(pC.price, pB.price, pD.price)
        r_XD := f_retrace_ratio(pA.price, pX.price, pD.price)

        // Check ratios against tolerance bands
        [ab_lo, ab_hi] = f_gart_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_gart_tol_BC(strict, lenient)
        [cd_lo, cd_hi] = f_gart_tol_CD(strict, lenient)
        [d_lo,  d_hi ] = f_gart_tol_D(strict, lenient)

        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        bool cd_ok = r_CD >= cd_lo and r_CD <= cd_hi
        bool d_ok  = r_XD >= d_lo  and r_XD <= d_hi

        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5
        else if not cd_ok
            status := 6
        else if not d_ok
            status := 7
        // else status stays 0 (valid)

    [status, bullish, r_AB, r_BC, r_CD, r_XD]


// ═══════════════════════════════════════════════════════════════════════════════
//  BAT VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Bat shares Gartley's structural family — D sits between X and A. Only the
//  ratio ideals differ: B=0.500 (shallower than Gartley's 0.618), D=0.886
//  (deeper than Gartley's 0.786). Status codes identical to Gartley validator.
//
// ═══════════════════════════════════════════════════════════════════════════════

f_validate_bat(Pivot pX, Pivot pA, Pivot pB, Pivot pC, Pivot pD) =>
    // Direction alternation check (identical to Gartley)
    bool dir_ok = (pX.isHigh != pA.isHigh) and
                  (pA.isHigh != pB.isHigh) and
                  (pB.isHigh != pC.isHigh) and
                  (pC.isHigh != pD.isHigh)
    bool bullish = not pX.isHigh

    // Structural ordering (identical to Gartley — D between X and C, above X)
    bool struct_ok = false
    if bullish
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price and
                     pD.price > pX.price and pD.price < pC.price
    else
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price and
                     pD.price < pX.price and pD.price > pC.price

    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0
    float r_CD   = 0.0
    float r_XD   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        r_CD := f_retrace_ratio(pC.price, pB.price, pD.price)
        r_XD := f_retrace_ratio(pA.price, pX.price, pD.price)

        [ab_lo, ab_hi] = f_bat_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_bat_tol_BC(strict, lenient)
        [cd_lo, cd_hi] = f_bat_tol_CD(strict, lenient)
        [d_lo,  d_hi ] = f_bat_tol_D(strict, lenient)

        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        bool cd_ok = r_CD >= cd_lo and r_CD <= cd_hi
        bool d_ok  = r_XD >= d_lo  and r_XD <= d_hi

        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5
        else if not cd_ok
            status := 6
        else if not d_ok
            status := 7

    [status, bullish, r_AB, r_BC, r_CD, r_XD]


// ═══════════════════════════════════════════════════════════════════════════════
//  ALT BAT VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Alt Bat is structurally different: D extends BEYOND X (r_XD > 1.0). This
//  makes it geometrically closer to Crab/Butterfly than to Gartley/Bat despite
//  the "retracement" naming. The structural check requires D below X (bullish)
//  or D above X (bearish).
//
//  Ideal ratios: B=0.382 (very shallow retrace), D=1.130 (D 13% past X).
//
// ═══════════════════════════════════════════════════════════════════════════════

f_validate_alt_bat(Pivot pX, Pivot pA, Pivot pB, Pivot pC, Pivot pD) =>
    bool dir_ok = (pX.isHigh != pA.isHigh) and
                  (pA.isHigh != pB.isHigh) and
                  (pB.isHigh != pC.isHigh) and
                  (pC.isHigh != pD.isHigh)
    bool bullish = not pX.isHigh

    // Structural ordering — note D is BEYOND X (extension)
    bool struct_ok = false
    if bullish
        // Bullish: X low, A high, B < A (shallow retrace from A), C between B and A, D below X
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price and
                     pD.price < pX.price
    else
        // Bearish: X high, A low, B > A (shallow bounce), C between A and B, D above X
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price and
                     pD.price > pX.price

    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0
    float r_CD   = 0.0
    float r_XD   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        r_CD := f_retrace_ratio(pC.price, pB.price, pD.price)
        r_XD := f_retrace_ratio(pA.price, pX.price, pD.price)
        // r_XD > 1.0 for Alt Bat since D is past X

        [ab_lo, ab_hi] = f_abat_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_abat_tol_BC(strict, lenient)
        [cd_lo, cd_hi] = f_abat_tol_CD(strict, lenient)
        [d_lo,  d_hi ] = f_abat_tol_D(strict, lenient)

        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        bool cd_ok = r_CD >= cd_lo and r_CD <= cd_hi
        bool d_ok  = r_XD >= d_lo  and r_XD <= d_hi

        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5
        else if not cd_ok
            status := 6
        else if not d_ok
            status := 7

    [status, bullish, r_AB, r_BC, r_CD, r_XD]


// ═══════════════════════════════════════════════════════════════════════════════
//  BUTTERFLY VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Butterfly is an extension pattern: D extends beyond X (r_XD > 1.0).
//  Same structural family as Alt Bat/Crab/Deep Crab — only ratio ideals differ.
//  Ideals: B=0.786 (deep retrace), D=1.272 (moderate extension beyond X).
//
// ═══════════════════════════════════════════════════════════════════════════════

f_validate_butterfly(Pivot pX, Pivot pA, Pivot pB, Pivot pC, Pivot pD) =>
    bool dir_ok = (pX.isHigh != pA.isHigh) and
                  (pA.isHigh != pB.isHigh) and
                  (pB.isHigh != pC.isHigh) and
                  (pC.isHigh != pD.isHigh)
    bool bullish = not pX.isHigh

    // Extension structure: D beyond X
    bool struct_ok = false
    if bullish
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price and
                     pD.price < pX.price
    else
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price and
                     pD.price > pX.price

    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0
    float r_CD   = 0.0
    float r_XD   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        r_CD := f_retrace_ratio(pC.price, pB.price, pD.price)
        r_XD := f_retrace_ratio(pA.price, pX.price, pD.price)

        [ab_lo, ab_hi] = f_bfly_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_bfly_tol_BC(strict, lenient)
        [cd_lo, cd_hi] = f_bfly_tol_CD(strict, lenient)
        [d_lo,  d_hi ] = f_bfly_tol_D(strict, lenient)

        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        bool cd_ok = r_CD >= cd_lo and r_CD <= cd_hi
        bool d_ok  = r_XD >= d_lo  and r_XD <= d_hi

        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5
        else if not cd_ok
            status := 6
        else if not d_ok
            status := 7

    [status, bullish, r_AB, r_BC, r_CD, r_XD]


// ═══════════════════════════════════════════════════════════════════════════════
//  CRAB VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Crab is the deepest extension of all patterns — D at 1.618 of XA (62% past X).
//  Ideals: B=0.500 (mid retrace), D=1.618. CD projection 2.618-3.618 of BC.
//
// ═══════════════════════════════════════════════════════════════════════════════

f_validate_crab(Pivot pX, Pivot pA, Pivot pB, Pivot pC, Pivot pD) =>
    bool dir_ok = (pX.isHigh != pA.isHigh) and
                  (pA.isHigh != pB.isHigh) and
                  (pB.isHigh != pC.isHigh) and
                  (pC.isHigh != pD.isHigh)
    bool bullish = not pX.isHigh

    bool struct_ok = false
    if bullish
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price and
                     pD.price < pX.price
    else
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price and
                     pD.price > pX.price

    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0
    float r_CD   = 0.0
    float r_XD   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        r_CD := f_retrace_ratio(pC.price, pB.price, pD.price)
        r_XD := f_retrace_ratio(pA.price, pX.price, pD.price)

        [ab_lo, ab_hi] = f_crab_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_crab_tol_BC(strict, lenient)
        [cd_lo, cd_hi] = f_crab_tol_CD(strict, lenient)
        [d_lo,  d_hi ] = f_crab_tol_D(strict, lenient)

        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        bool cd_ok = r_CD >= cd_lo and r_CD <= cd_hi
        bool d_ok  = r_XD >= d_lo  and r_XD <= d_hi

        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5
        else if not cd_ok
            status := 6
        else if not d_ok
            status := 7

    [status, bullish, r_AB, r_BC, r_CD, r_XD]


// ═══════════════════════════════════════════════════════════════════════════════
//  DEEP CRAB VALIDATION
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Deep Crab differs from Crab only in the B ratio: 0.886 instead of 0.500.
//  D and CD ideals are identical to Crab. PRZ is also identical to Crab.
//
// ═══════════════════════════════════════════════════════════════════════════════

f_validate_deep_crab(Pivot pX, Pivot pA, Pivot pB, Pivot pC, Pivot pD) =>
    bool dir_ok = (pX.isHigh != pA.isHigh) and
                  (pA.isHigh != pB.isHigh) and
                  (pB.isHigh != pC.isHigh) and
                  (pC.isHigh != pD.isHigh)
    bool bullish = not pX.isHigh

    bool struct_ok = false
    if bullish
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price and
                     pD.price < pX.price
    else
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price and
                     pD.price > pX.price

    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0
    float r_CD   = 0.0
    float r_XD   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        r_CD := f_retrace_ratio(pC.price, pB.price, pD.price)
        r_XD := f_retrace_ratio(pA.price, pX.price, pD.price)

        [ab_lo, ab_hi] = f_dcrab_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_dcrab_tol_BC(strict, lenient)
        [cd_lo, cd_hi] = f_dcrab_tol_CD(strict, lenient)
        [d_lo,  d_hi ] = f_dcrab_tol_D(strict, lenient)

        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        bool cd_ok = r_CD >= cd_lo and r_CD <= cd_hi
        bool d_ok  = r_XD >= d_lo  and r_XD <= d_hi

        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5
        else if not cd_ok
            status := 6
        else if not d_ok
            status := 7

    [status, bullish, r_AB, r_BC, r_CD, r_XD]


// ═══════════════════════════════════════════════════════════════════════════════
//  FORMING VALIDATORS  (XABC-only — D not yet printed)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Each forming validator checks the first 5 gates only:
//    1) Direction alternation (X/A, A/B, B/C — 3 checks instead of 4)
//    2) Structural ordering through C (no D placement check)
//    3) XA size filter
//    4) AB ratio band
//    5) BC ratio band
//
//  Status codes match the confirmed validators (1=dir, 2=struct, 3=XA, 4=AB,
//  5=BC) for consistency. Codes 6-7 (CD band, D band) are never returned since
//  D doesn't exist yet.
//
//  Returns [status, bullish, r_AB, r_BC]. r_CD and r_XD are unknowable.
//
// ═══════════════════════════════════════════════════════════════════════════════

// Gartley structure (D between X and A — same as confirmed)
f_validate_gartley_forming(Pivot pX, Pivot pA, Pivot pB, Pivot pC) =>
    bool dir_ok = (pX.isHigh != pA.isHigh) and (pA.isHigh != pB.isHigh) and (pB.isHigh != pC.isHigh)
    bool bullish = not pX.isHigh

    bool struct_ok = false
    if bullish
        struct_ok := pX.price < pA.price and
                     pB.price > pX.price and pB.price < pA.price and
                     pC.price > pB.price and pC.price < pA.price
    else
        struct_ok := pX.price > pA.price and
                     pB.price < pX.price and pB.price > pA.price and
                     pC.price < pB.price and pC.price > pA.price

    float xa_abs = math.abs(pA.price - pX.price)
    bool  xa_big_enough = xa_abs >= i_min_xa_atr * atr_v

    int   status = 0
    float r_AB   = 0.0
    float r_BC   = 0.0

    if not dir_ok
        status := 1
    else if not struct_ok
        status := 2
    else if not xa_big_enough
        status := 3
    else
        r_AB := f_retrace_ratio(pA.price, pX.price, pB.price)
        r_BC := f_retrace_ratio(pB.price, pA.price, pC.price)
        [ab_lo, ab_hi] = f_gart_tol_B(strict, lenient)
        [bc_lo, bc_hi] = f_gart_tol_BC(strict, lenient)
        bool ab_ok = r_AB >= ab_lo and r_AB <= ab_hi
        bool bc_ok = r_BC >= bc_lo and r_BC <= bc_hi
        if not ab_ok
            status := 4
        else if not bc_ok
            status := 5

    [status, bullish, r_AB, r_BC]


