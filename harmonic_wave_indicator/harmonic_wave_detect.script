    projs.push(Projection.new("2.618 BC", d_2618, false))

    // 4) 1.27 AB=CD
    float ab_vec = f_LP(pB.price) - f_LP(pA.price)
    float d_abcd_127 = f_FP(f_LP(pC.price) + 1.27 * ab_vec)
    projs.push(Projection.new("1.27 AB=CD", d_abcd_127, false))

    // Outlier filtering
    array<float> prices = array.new<float>(0)
    for i = 0 to projs.size() - 1
        prices.push(projs.get(i).price)
    float med = array.median(prices)

    float prz_top = na
    float prz_bot = na
    int   conf_count = 0
    for i = 0 to projs.size() - 1
        Projection p = projs.get(i)
        if math.abs(p.price - med) <= 3.0 * atr_v
            p.in_prz := true
            projs.set(i, p)
            conf_count += 1
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    if na(prz_top)
        for i = 0 to projs.size() - 1
            Projection p = projs.get(i)
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    PRZ.new(prz_top, prz_bot, projs, conf_count)


// ═══════════════════════════════════════════════════════════════════════════════
//  PRZ ZONE CONSTRUCTION (Crab — shared with Deep Crab)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Crab / Deep Crab projections:
//    1)  D at 1.618 extension of XA
//    2)  D at 2.618 projection of BC
//    3)  D at 3.618 projection of BC
//    4)  D at 1.27 AB=CD
//
//  Same PRZ for both patterns — they're distinguished by B ratio only.
//
// ═══════════════════════════════════════════════════════════════════════════════

f_build_crab_prz(Pivot pX, Pivot pA, Pivot pB, Pivot pC, bool bullish) =>
    array<Projection> projs = array.new<Projection>(0)

    // 1) 1.618 extension of XA
    float d_1618_xa = f_FP(f_LP(pA.price) - 1.618 * (f_LP(pA.price) - f_LP(pX.price)))
    projs.push(Projection.new("1.618 XA", d_1618_xa, false))

    // 2) 2.618 projection of BC
    float d_2618 = f_FP(f_LP(pC.price) - 2.618 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("2.618 BC", d_2618, false))

    // 3) 3.618 projection of BC
    float d_3618 = f_FP(f_LP(pC.price) - 3.618 * (f_LP(pC.price) - f_LP(pB.price)))
    projs.push(Projection.new("3.618 BC", d_3618, false))

    // 4) 1.27 AB=CD
    float ab_vec = f_LP(pB.price) - f_LP(pA.price)
    float d_abcd_127 = f_FP(f_LP(pC.price) + 1.27 * ab_vec)
    projs.push(Projection.new("1.27 AB=CD", d_abcd_127, false))

    // Outlier filtering
    array<float> prices = array.new<float>(0)
    for i = 0 to projs.size() - 1
        prices.push(projs.get(i).price)
    float med = array.median(prices)

    float prz_top = na
    float prz_bot = na
    int   conf_count = 0
    for i = 0 to projs.size() - 1
        Projection p = projs.get(i)
        if math.abs(p.price - med) <= 3.0 * atr_v
            p.in_prz := true
            projs.set(i, p)
            conf_count += 1
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    if na(prz_top)
        for i = 0 to projs.size() - 1
            Projection p = projs.get(i)
            prz_top := na(prz_top) ? p.price : math.max(prz_top, p.price)
            prz_bot := na(prz_bot) ? p.price : math.min(prz_bot, p.price)

    PRZ.new(prz_top, prz_bot, projs, conf_count)


// ═══════════════════════════════════════════════════════════════════════════════
//  SCORING (0–10)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Three components:
//    Ratio precision  (0-4): mean proximity of r_AB and r_XD to their ideals
//    PRZ tightness    (0-3): 1 - (zone_height / (3 × ATR)), clipped to [0,1], × 3
//    Confluence count (0-3): number of projections in final PRZ, capped at 3
//
//  Penalty: if AB=CD does not converge inside the PRZ AND user has enabled penalty,
//  subtract 2 from the total (minimum 0).
//
//  Per-pattern ideals:
//    Gartley  — B=0.618 / D=0.786
//    Bat      — B=0.500 / D=0.886
//    Alt Bat  — B=0.382 / D=1.130
//
// ═══════════════════════════════════════════════════════════════════════════════

f_score_gartley(float r_AB, float r_XD, PRZ prz, bool abcd_conv) =>
    // Ratio precision (normalized by Lenient band half-width = 0.100 for both)
    float ab_dev  = math.abs(r_AB - 0.618)
    float xd_dev  = math.abs(r_XD - 0.786)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float xd_norm = 1.0 - math.min(xd_dev / 0.100, 1.0)
    float ratio_score = (ab_norm + xd_norm) * 2.0   // 0–4

    // PRZ zone tightness
    float zone_h   = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0              // 0–3

    // Confluence
    float conf_score = math.min(prz.confluence_count, 3)   // 0–3

    float total = ratio_score + tight_score + conf_score

    // AB=CD non-convergence penalty (only if user opted in)
    if not abcd_conv and i_penalize_no_abcd
        total := math.max(0.0, total - 2.0)

    math.round(total * 10.0) / 10.0


f_score_bat(float r_AB, float r_XD, PRZ prz, bool abcd_conv) =>
    // Bat ideals: B=0.500, D=0.886
    float ab_dev  = math.abs(r_AB - 0.500)
    float xd_dev  = math.abs(r_XD - 0.886)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float xd_norm = 1.0 - math.min(xd_dev / 0.100, 1.0)
    float ratio_score = (ab_norm + xd_norm) * 2.0

    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0

    float conf_score = math.min(prz.confluence_count, 3)

    float total = ratio_score + tight_score + conf_score

    if not abcd_conv and i_penalize_no_abcd
        total := math.max(0.0, total - 2.0)

    math.round(total * 10.0) / 10.0


f_score_alt_bat(float r_AB, float r_XD, PRZ prz, bool abcd_conv) =>
    // Alt Bat ideals: B=0.382, D=1.130
    float ab_dev  = math.abs(r_AB - 0.382)
    float xd_dev  = math.abs(r_XD - 1.130)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float xd_norm = 1.0 - math.min(xd_dev / 0.100, 1.0)
    float ratio_score = (ab_norm + xd_norm) * 2.0

    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0

    float conf_score = math.min(prz.confluence_count, 3)

    float total = ratio_score + tight_score + conf_score

    if not abcd_conv and i_penalize_no_abcd
        total := math.max(0.0, total - 2.0)

    math.round(total * 10.0) / 10.0


f_score_butterfly(float r_AB, float r_XD, PRZ prz, bool abcd_conv) =>
    // Butterfly ideals: B=0.786, D=1.272
    float ab_dev  = math.abs(r_AB - 0.786)
    float xd_dev  = math.abs(r_XD - 1.272)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float xd_norm = 1.0 - math.min(xd_dev / 0.100, 1.0)
    float ratio_score = (ab_norm + xd_norm) * 2.0

    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0

    float conf_score = math.min(prz.confluence_count, 3)

    float total = ratio_score + tight_score + conf_score

    if not abcd_conv and i_penalize_no_abcd
        total := math.max(0.0, total - 2.0)

    math.round(total * 10.0) / 10.0


f_score_crab(float r_AB, float r_XD, PRZ prz, bool abcd_conv) =>
    // Crab ideals: B=0.500, D=1.618
    float ab_dev  = math.abs(r_AB - 0.500)
    float xd_dev  = math.abs(r_XD - 1.618)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float xd_norm = 1.0 - math.min(xd_dev / 0.100, 1.0)
    float ratio_score = (ab_norm + xd_norm) * 2.0

    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0

    float conf_score = math.min(prz.confluence_count, 3)

    float total = ratio_score + tight_score + conf_score

    if not abcd_conv and i_penalize_no_abcd
        total := math.max(0.0, total - 2.0)

    math.round(total * 10.0) / 10.0


f_score_deep_crab(float r_AB, float r_XD, PRZ prz, bool abcd_conv) =>
    // Deep Crab ideals: B=0.886, D=1.618
    float ab_dev  = math.abs(r_AB - 0.886)
    float xd_dev  = math.abs(r_XD - 1.618)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float xd_norm = 1.0 - math.min(xd_dev / 0.100, 1.0)
    float ratio_score = (ab_norm + xd_norm) * 2.0

    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0

    float conf_score = math.min(prz.confluence_count, 3)

    float total = ratio_score + tight_score + conf_score

    if not abcd_conv and i_penalize_no_abcd
        total := math.max(0.0, total - 2.0)

    math.round(total * 10.0) / 10.0


// ═══════════════════════════════════════════════════════════════════════════════
//  FORMING SCORING  (0-8 scale — no r_XD, no AB=CD penalty)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Forming patterns can't compute the full 0-10 score because:
//    • r_XD doesn't exist (D not yet printed) → ratio precision halved (max 2.0)
//    • AB=CD convergence inside PRZ can't be checked → no penalty applied
//
//  Components retained:
//    • Ratio precision  (0-2): only ab_norm × 2.0
//    • PRZ tightness    (0-3): same as confirmed
//    • Confluence count (0-3): same as confirmed
//
//  Max forming score = 8.0. Display as "[X.X/8]" in labels to signal the
//  asymmetry vs confirmed patterns scoring on /10.
//
// ═══════════════════════════════════════════════════════════════════════════════

f_score_gartley_forming(float r_AB, PRZ prz) =>
    float ab_dev  = math.abs(r_AB - 0.618)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float ratio_score = ab_norm * 2.0
    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0
    float conf_score = math.min(prz.confluence_count, 3)
    float total = ratio_score + tight_score + conf_score
    math.round(total * 10.0) / 10.0


f_score_bat_forming(float r_AB, PRZ prz) =>
    float ab_dev  = math.abs(r_AB - 0.500)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float ratio_score = ab_norm * 2.0
    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0
    float conf_score = math.min(prz.confluence_count, 3)
    float total = ratio_score + tight_score + conf_score
    math.round(total * 10.0) / 10.0


f_score_alt_bat_forming(float r_AB, PRZ prz) =>
    float ab_dev  = math.abs(r_AB - 0.382)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float ratio_score = ab_norm * 2.0
    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0
    float conf_score = math.min(prz.confluence_count, 3)
    float total = ratio_score + tight_score + conf_score
    math.round(total * 10.0) / 10.0


f_score_butterfly_forming(float r_AB, PRZ prz) =>
    float ab_dev  = math.abs(r_AB - 0.786)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float ratio_score = ab_norm * 2.0
    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0
    float conf_score = math.min(prz.confluence_count, 3)
    float total = ratio_score + tight_score + conf_score
    math.round(total * 10.0) / 10.0


f_score_crab_forming(float r_AB, PRZ prz) =>
    float ab_dev  = math.abs(r_AB - 0.500)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float ratio_score = ab_norm * 2.0
    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0
    float conf_score = math.min(prz.confluence_count, 3)
    float total = ratio_score + tight_score + conf_score
    math.round(total * 10.0) / 10.0


f_score_deep_crab_forming(float r_AB, PRZ prz) =>
    float ab_dev  = math.abs(r_AB - 0.886)
    float ab_norm = 1.0 - math.min(ab_dev / 0.100, 1.0)
    float ratio_score = ab_norm * 2.0
    float zone_h    = prz.top - prz.bot
    float tightness = 1.0 - math.min(zone_h / (atr_v * 3.0), 1.0)
    float tight_score = tightness * 3.0
    float conf_score = math.min(prz.confluence_count, 3)
    float total = ratio_score + tight_score + conf_score
    math.round(total * 10.0) / 10.0


// ═══════════════════════════════════════════════════════════════════════════════
//  PATTERN DRAWING  (generic — uses pat.pattern_type for labeling)
// ═══════════════════════════════════════════════════════════════════════════════

f_draw_pattern(HarmonicPattern pat) =>
    color dir_color  = pat.is_bullish ? i_color_bull : i_color_bear
    bool  warn       = not pat.abcd_converges
    color line_col   = warn ? i_color_warn : dir_color

    // State flags — exactly one of these is true (or neither for Confirmed)
    bool is_borderline = pat.state == "Borderline"
    bool is_forming    = pat.state == "Forming"
    bool is_failed     = pat.state == "Failed"

    // Visual hierarchy by state:
    //   Confirmed:   solid legs,  width 2, full color   — alert-eligible
    //   Borderline:  dashed legs, width 1, dimmed       — score 4-5.9
    //   Forming:     dotted legs, width 1, very faded   — D not yet printed
    //   Failed:      solid legs,  width 1, gray         — D printed but invalid
    color leg_col = is_failed ? color.new(color.gray, 25) : is_forming ? color.new(line_col, 30) : is_borderline ? color.new(line_col, 45) : line_col
    string leg_style = is_borderline ? line.style_dashed : is_forming ? line.style_dotted : line.style_solid
    int leg_width = (is_borderline or is_forming or is_failed) ? 1 : 2

    color prz_fill = is_forming ? color.new(dir_color, 95) : is_borderline ? color.new(dir_color, 92) : color.new(dir_color, 85)

    array<line>  new_lines  = array.new<line>(0)
    array<label> new_labels = array.new<label>(0)
    array<box>   new_boxes  = array.new<box>(0)

    // ── Legs ───────────────────────────────────────────────────────────────────
    // Forming patterns have only X→A, A→B, B→C (no D yet).
    // Confirmed/Borderline/Failed have all four legs (X→A→B→C→D).
    new_lines.push(line.new(pat.pX.bi, pat.pX.price, pat.pA.bi, pat.pA.price,
         color=leg_col, width=leg_width, style=leg_style))
    new_lines.push(line.new(pat.pA.bi, pat.pA.price, pat.pB.bi, pat.pB.price,
         color=leg_col, width=leg_width, style=leg_style))
    new_lines.push(line.new(pat.pB.bi, pat.pB.price, pat.pC.bi, pat.pC.price,
         color=leg_col, width=leg_width, style=leg_style))
    if not is_forming
        new_lines.push(line.new(pat.pC.bi, pat.pC.price, pat.pD.bi, pat.pD.price,
             color=leg_col, width=leg_width, style=leg_style))

    // ── PRZ zone box ───────────────────────────────────────────────────────────
    // Confirmed/Borderline: from C to D+10 bars, solid border
    // Forming:              from C+1 to bar_index+10, dashed border
    // Failed:               no PRZ box (the prediction was wrong)
    if not is_failed
        int box_start  = pat.pC.bi + (is_forming ? 1 : 0)
        int box_end    = is_forming ? bar_index + 10 : pat.pD.bi + 10
        color box_col  = is_borderline ? color.new(dir_color, 50) : is_forming ? color.new(dir_color, 30) : dir_color
        int box_border_w = (is_borderline or is_forming) ? 1 : 2
        string box_border_style = is_forming ? line.style_dashed : line.style_solid
        new_boxes.push(box.new(box_start, pat.prz.top, box_end, pat.prz.bot,
             border_color = box_col,
             bgcolor      = prz_fill,
             border_width = box_border_w,
             border_style = box_border_style))

    // ── Pivot labels ───────────────────────────────────────────────────────────
    if i_show_pivot_labels and not i_clean
        color piv_col = is_failed ? color.new(color.gray, 50) : is_forming ? color.new(dir_color, 70) : is_borderline ? color.new(dir_color, 65) : color.new(dir_color, 40)
        new_labels.push(label.new(pat.pX.bi, pat.pX.price, "X",
             style=pat.pX.isHigh ? label.style_label_down : label.style_label_up,
             color=piv_col, textcolor=color.white, size=size.tiny))
        new_labels.push(label.new(pat.pA.bi, pat.pA.price, "A",
             style=pat.pA.isHigh ? label.style_label_down : label.style_label_up,
             color=piv_col, textcolor=color.white, size=size.tiny))
        new_labels.push(label.new(pat.pB.bi, pat.pB.price, "B",
             style=pat.pB.isHigh ? label.style_label_down : label.style_label_up,
             color=piv_col, textcolor=color.white, size=size.tiny))
        new_labels.push(label.new(pat.pC.bi, pat.pC.price, "C",
             style=pat.pC.isHigh ? label.style_label_down : label.style_label_up,
             color=piv_col, textcolor=color.white, size=size.tiny))
        if not is_forming
            new_labels.push(label.new(pat.pD.bi, pat.pD.price, "D",
                 style=pat.pD.isHigh ? label.style_label_down : label.style_label_up,
                 color=piv_col, textcolor=color.white, size=size.tiny))

    // ── Ratio labels on leg midpoints ──────────────────────────────────────────
    if i_show_ratio_labels and not i_clean
        color ratio_col = is_failed ? color.new(color.gray, 60) : is_forming ? color.new(dir_color, 60) : is_borderline ? color.new(dir_color, 55) : color.new(dir_color, 30)
        int   mid_AB   = math.round((pat.pA.bi + pat.pB.bi) / 2.0)
        float mid_AB_p = (pat.pA.price + pat.pB.price) / 2.0
        new_labels.push(label.new(mid_AB, mid_AB_p, str.format("{0,number,#.###}", pat.r_AB),
             style=label.style_none, textcolor=ratio_col, size=size.tiny))

        int   mid_BC   = math.round((pat.pB.bi + pat.pC.bi) / 2.0)
        float mid_BC_p = (pat.pB.price + pat.pC.price) / 2.0
        new_labels.push(label.new(mid_BC, mid_BC_p, str.format("{0,number,#.###}", pat.r_BC),
             style=label.style_none, textcolor=ratio_col, size=size.tiny))

        if not is_forming
            int   mid_CD   = math.round((pat.pC.bi + pat.pD.bi) / 2.0)
            float mid_CD_p = (pat.pC.price + pat.pD.price) / 2.0
            new_labels.push(label.new(mid_CD, mid_CD_p, str.format("{0,number,#.###}", pat.r_CD),
                 style=label.style_none, textcolor=ratio_col, size=size.tiny))

    // ── Pattern name + score label ─────────────────────────────────────────────
    // Forming: positioned at right edge of PRZ box (since D doesn't exist).
    // Failed:  positioned at D, gray, X marker, no score.
    // Confirmed/Borderline: positioned at D as before.
    if i_show_pat_label
        string arrow      = pat.is_bullish ? "▲ " : "▼ "
        string warn_mark  = warn ? "  ⚠" : ""
        string prefix     = is_borderline ? "(B) " : is_forming ? "(F) " : is_failed ? "(✗) " : ""
        string score_part = is_failed ? "" : is_forming ? "?  [" + str.tostring(pat.score, "#.#") + "/8]" : "  [" + str.tostring(pat.score, "#.#") + "/10]" + warn_mark
        string pat_txt    = prefix + arrow + pat.pattern_type + score_part
        color label_col   = is_failed ? color.new(color.gray, 30) : is_forming ? color.new(dir_color, 35) : is_borderline ? color.new(dir_color, 50) : warn ? i_color_warn : dir_color
        string label_size = (is_borderline or is_forming or is_failed) ? size.small : size.normal

        // Anchor: D for confirmed/borderline/failed; right edge of PRZ for forming
        int   anchor_bi    = is_forming ? bar_index + 10 : pat.pD.bi
        float anchor_price = is_forming ? (pat.prz.top + pat.prz.bot) / 2.0 : pat.pD.price
        // Style direction: forming labels at PRZ midpoint; others at D pivot
        bool  label_up = is_forming ? pat.is_bullish : pat.is_bullish
        new_labels.push(label.new(anchor_bi, anchor_price, pat_txt,
             style     = label_up ? label.style_label_up : label.style_label_down,
             color     = label_col,
             textcolor = color.white,
             size      = label_size))

    // ── PRZ projection lines (optional, verbose; not for Failed) ───────────────
    if i_show_projections and not is_failed
        int proj_transp = is_forming ? 80 : (is_borderline ? 75 : 60)
        // Forming: anchor projection lines at right edge; Confirmed/Borderline at D
        int proj_left  = is_forming ? bar_index - 5 : pat.pD.bi - 5
        int proj_right = is_forming ? bar_index + 10 : pat.pD.bi + 10
        for i = 0 to pat.prz.projections.size() - 1
            Projection pr = pat.prz.projections.get(i)
            color proj_col = pr.in_prz ? color.new(dir_color, proj_transp) : color.new(i_color_warn, proj_transp)
            new_lines.push(line.new(proj_left, pr.price, proj_right, pr.price,
                 color=proj_col, style=line.style_dashed, width=1))
            new_labels.push(label.new(proj_right, pr.price, pr.label,
                 style=label.style_none, textcolor=proj_col, size=size.tiny))

    // Attach drawing refs to the pattern object
    pat.lines  := new_lines
    pat.labels := new_labels
    pat.boxes  := new_boxes
    pat


// ═══════════════════════════════════════════════════════════════════════════════
//  MAIN: Pattern Scanning Loop
// ═══════════════════════════════════════════════════════════════════════════════
//
//  On every new confirmed pivot (not update-in-place), scan all valid 5-pivot
//  windows in the buffer. For each window, run the Gartley validator. If valid,
//  build the PRZ, check AB=CD convergence, compute the score, and draw.
//
//  Duplicate detection uses (pattern_type, pX.time, pD.time) as the key.
//  The buffer holds the last 12 pivots, so the scan is trivial (O(buffer_size)).
//
// ═══════════════════════════════════════════════════════════════════════════════

var array<HarmonicPattern> patterns_active = array.new<HarmonicPattern>(0)

// ── Diagnostic counters ────────────────────────────────────────────────────────
// Gartley-specific detailed rejection tracking. The other 5 patterns get
// acceptance-only counts in the diagnostics table — extending detailed
// per-gate tracking to all 6 would significantly enlarge the table for
// limited additional value. Gartley was chosen as the reference because
// its ideal ratios (B=0.618, D=0.786) are the most widely cited.
// Bat and Alt Bat get simpler acceptance-only counts (their rejection reasons
// follow the same taxonomy; detailed breakdown can be added later if needed).
var int diag_windows_tested   = 0
var int diag_rej_direction    = 0
var int diag_rej_structure    = 0
var int diag_rej_xa_small     = 0
var int diag_rej_ab           = 0
var int diag_rej_bc           = 0
var int diag_rej_cd           = 0
var int diag_rej_d            = 0
var int diag_rej_confluence   = 0
var int diag_rej_score        = 0
var int diag_accepted         = 0    // Total acceptances (all pattern types) — confirmed only
var int diag_accepted_gart    = 0
var int diag_accepted_bat     = 0
var int diag_accepted_abat    = 0
var int diag_accepted_bfly    = 0
var int diag_accepted_crab    = 0
var int diag_accepted_dcrab   = 0
var int diag_accepted_borderline = 0   // Borderline patterns (score in [borderline_min, min_score))
// Forming-mode lifecycle counters
var int diag_forming_active      = 0   // Currently visible forming patterns
var int diag_forming_to_confirmed = 0  // Cumulative: forming → confirmed transitions
var int diag_forming_to_failed   = 0   // Cumulative: forming patterns whose D didn't validate
var int diag_forming_to_stale    = 0   // Cumulative: forming patterns auto-deleted by decay

// Distribution tracking for candidates that passed structure+XA (status 0 or >=4)
var float diag_ab_min   = na
var float diag_ab_max   = na
var float diag_ab_sum   = 0.0
var int   diag_ab_count = 0
var float diag_xd_min   = na
var float diag_xd_max   = na
var float diag_xd_sum   = 0.0
var int   diag_xd_count = 0
var float diag_ab_best_val = na   // closest r_AB to ideal 0.618
var float diag_xd_best_val = na   // closest r_XD to ideal 0.786

// ── Alert fire flags (one per pattern × direction) ─────────────────────────────
// These are bar-scoped booleans driving the 12 named alertcondition() declarations
// at the bottom of the script. Reset to false every bar; set true inside the
// winner block when a new pattern of the corresponding type/direction confirms.
// Note: if multiple patterns confirm on the same bar (different windows), more
// than one flag may be set — alertcondition() handles that correctly.
fired_gartley_bull = false
fired_gartley_bear = false
fired_bat_bull     = false
fired_bat_bear     = false
fired_abat_bull    = false
fired_abat_bear    = false
fired_bfly_bull    = false
fired_bfly_bear    = false
fired_crab_bull    = false
fired_crab_bear    = false
fired_dcrab_bull   = false
fired_dcrab_bear   = false

if (i_scan_gartley or i_scan_bat or i_scan_alt_bat or i_scan_butterfly or i_scan_crab or i_scan_deep_crab) and new_pivot_added and pivot_buf.size() >= 6
    // For each valid 5-pivot window (with a 6th pivot confirming D):
    // window = pivot_buf[start .. start+4], confirmation = pivot_buf[start+5]
    for start = 0 to pivot_buf.size() - 6
        Pivot pX = pivot_buf.get(start)
        Pivot pA = pivot_buf.get(start + 1)
        Pivot pB = pivot_buf.get(start + 2)
        Pivot pC = pivot_buf.get(start + 3)
        Pivot pD = pivot_buf.get(start + 4)

        // Duplicate check — considers ALL pattern types for this window
        bool duplicate = false
        if patterns_active.size() > 0
            for j = 0 to patterns_active.size() - 1
                HarmonicPattern ex = patterns_active.get(j)
                if ex.pX.t == pX.t and ex.pD.t == pD.t
                    duplicate := true
                    break

        if not duplicate
            diag_windows_tested := diag_windows_tested + 1

            // ── Run all enabled validators ────────────────────────────────
            // Each returns [status, bullish, r_AB, r_BC, r_CD, r_XD].
            // status == 0 means valid; 1-7 are rejection codes.
            int   g_status = -1
            bool  g_bullish = false
            float g_rAB = 0.0, g_rBC = 0.0, g_rCD = 0.0, g_rXD = 0.0
            if i_scan_gartley
                [s, b, ab, bc, cd, xd] = f_validate_gartley(pX, pA, pB, pC, pD)
                g_status := s
                g_bullish := b
                g_rAB := ab
                g_rBC := bc
                g_rCD := cd
                g_rXD := xd

            int   b_status = -1
            bool  b_bullish = false
            float b_rAB = 0.0, b_rBC = 0.0, b_rCD = 0.0, b_rXD = 0.0
            if i_scan_bat
                [s, b, ab, bc, cd, xd] = f_validate_bat(pX, pA, pB, pC, pD)
                b_status := s
                b_bullish := b
                b_rAB := ab
                b_rBC := bc
                b_rCD := cd
                b_rXD := xd

            int   a_status = -1
            bool  a_bullish = false
            float a_rAB = 0.0, a_rBC = 0.0, a_rCD = 0.0, a_rXD = 0.0
            if i_scan_alt_bat
                [s, b, ab, bc, cd, xd] = f_validate_alt_bat(pX, pA, pB, pC, pD)
                a_status := s
                a_bullish := b
                a_rAB := ab
                a_rBC := bc
                a_rCD := cd
                a_rXD := xd

            int   bf_status = -1
            bool  bf_bullish = false
            float bf_rAB = 0.0, bf_rBC = 0.0, bf_rCD = 0.0, bf_rXD = 0.0
            if i_scan_butterfly
                [s, b, ab, bc, cd, xd] = f_validate_butterfly(pX, pA, pB, pC, pD)
                bf_status := s
                bf_bullish := b
                bf_rAB := ab
                bf_rBC := bc
                bf_rCD := cd
                bf_rXD := xd

            int   cr_status = -1
            bool  cr_bullish = false
            float cr_rAB = 0.0, cr_rBC = 0.0, cr_rCD = 0.0, cr_rXD = 0.0
            if i_scan_crab
                [s, b, ab, bc, cd, xd] = f_validate_crab(pX, pA, pB, pC, pD)
                cr_status := s
                cr_bullish := b
                cr_rAB := ab
                cr_rBC := bc
                cr_rCD := cd
                cr_rXD := xd

            int   dc_status = -1
            bool  dc_bullish = false
            float dc_rAB = 0.0, dc_rBC = 0.0, dc_rCD = 0.0, dc_rXD = 0.0
            if i_scan_deep_crab
                [s, b, ab, bc, cd, xd] = f_validate_deep_crab(pX, pA, pB, pC, pD)
                dc_status := s
                dc_bullish := b
                dc_rAB := ab
                dc_rBC := bc
                dc_rCD := cd
                dc_rXD := xd

            // ── Gartley-specific diagnostic tracking ─────────────────────
            // Per-gate rejection counters and ratio distribution stats are
            // tracked using Gartley's status codes only. Bat/Alt Bat/Butterfly/
            // Crab/Deep Crab get acceptance-only counts in the diagnostics
            // table to keep the display compact.
            if g_status >= 0
                if g_status == 0 or g_status >= 4
                    diag_ab_min := na(diag_ab_min) ? g_rAB : math.min(diag_ab_min, g_rAB)
                    diag_ab_max := na(diag_ab_max) ? g_rAB : math.max(diag_ab_max, g_rAB)
                    diag_ab_sum := diag_ab_sum + g_rAB
                    diag_ab_count := diag_ab_count + 1

                    diag_xd_min := na(diag_xd_min) ? g_rXD : math.min(diag_xd_min, g_rXD)
                    diag_xd_max := na(diag_xd_max) ? g_rXD : math.max(diag_xd_max, g_rXD)
                    diag_xd_sum := diag_xd_sum + g_rXD
                    diag_xd_count := diag_xd_count + 1

                    if na(diag_ab_best_val) or math.abs(g_rAB - 0.618) < math.abs(diag_ab_best_val - 0.618)
                        diag_ab_best_val := g_rAB
                    if na(diag_xd_best_val) or math.abs(g_rXD - 0.786) < math.abs(diag_xd_best_val - 0.786)
                        diag_xd_best_val := g_rXD

                if g_status == 1
                    diag_rej_direction := diag_rej_direction + 1
                else if g_status == 2
                    diag_rej_structure := diag_rej_structure + 1
                else if g_status == 3
                    diag_rej_xa_small := diag_rej_xa_small + 1
                else if g_status == 4
                    diag_rej_ab := diag_rej_ab + 1
                else if g_status == 5
                    diag_rej_bc := diag_rej_bc + 1
                else if g_status == 6
                    diag_rej_cd := diag_rej_cd + 1
                else if g_status == 7
                    diag_rej_d := diag_rej_d + 1

            // ── Build PRZ + score for each validator that returned status == 0 ──
            // Keep the highest-scoring valid match. Priority on ties: Gartley > Bat > Alt Bat.
            string winner_type  = ""
            string winner_state = "Confirmed"
            float  winner_score = -1.0
            PRZ    winner_prz   = na
            bool   winner_abcd  = false
            bool   winner_bull  = false
            float  winner_rAB   = 0.0
            float  winner_rBC   = 0.0
            float  winner_rCD   = 0.0
            float  winner_rXD   = 0.0
            int    winner_conf_count = 0

            // Track whether any valid match passed confluence+score gates
            bool any_rej_confluence = false
            bool any_rej_score      = false

            // Gartley candidate
            if g_status == 0
                PRZ prz = f_build_gartley_prz(pX, pA, pB, pC, g_bullish)
                bool abcd_conv = false
                for k = 0 to prz.projections.size() - 1
                    Projection pr = prz.projections.get(k)
                    if pr.label == "AB=CD" and pr.in_prz
                        abcd_conv := true
                        break
                if prz.confluence_count < i_min_conf
                    any_rej_confluence := true
                else
                    float sc = f_score_gartley(g_rAB, g_rXD, prz, abcd_conv)
                    bool eligible = sc >= i_min_score or (i_show_borderline and sc >= i_borderline_min_score)
                    if not eligible
                        any_rej_score := true
                    else if sc > winner_score
                        winner_type  := "Gartley"
                        winner_state := sc >= i_min_score ? "Confirmed" : "Borderline"
                        winner_score := sc
                        winner_prz   := prz
                        winner_abcd  := abcd_conv
                        winner_bull  := g_bullish
                        winner_rAB   := g_rAB
                        winner_rBC   := g_rBC
                        winner_rCD   := g_rCD
                        winner_rXD   := g_rXD
                        winner_conf_count := prz.confluence_count

            // Bat candidate
            if b_status == 0
                PRZ prz = f_build_bat_prz(pX, pA, pB, pC, b_bullish)
                // AB=CD convergence: either AB=CD or 1.27 AB=CD inside PRZ counts
                bool abcd_conv = false
                for k = 0 to prz.projections.size() - 1
                    Projection pr = prz.projections.get(k)
                    if (pr.label == "AB=CD" or pr.label == "1.27 AB=CD") and pr.in_prz
                        abcd_conv := true
                        break
                if prz.confluence_count < i_min_conf
                    any_rej_confluence := true
                else
                    float sc = f_score_bat(b_rAB, b_rXD, prz, abcd_conv)
                    bool eligible = sc >= i_min_score or (i_show_borderline and sc >= i_borderline_min_score)
                    if not eligible
                        any_rej_score := true
                    else if sc > winner_score
                        winner_type  := "Bat"
                        winner_state := sc >= i_min_score ? "Confirmed" : "Borderline"
                        winner_score := sc
                        winner_prz   := prz
                        winner_abcd  := abcd_conv
                        winner_bull  := b_bullish
                        winner_rAB   := b_rAB
                        winner_rBC   := b_rBC
                        winner_rCD   := b_rCD
                        winner_rXD   := b_rXD
                        winner_conf_count := prz.confluence_count

            // Alt Bat candidate
            if a_status == 0
                PRZ prz = f_build_alt_bat_prz(pX, pA, pB, pC, a_bullish)
                bool abcd_conv = false
                for k = 0 to prz.projections.size() - 1
                    Projection pr = prz.projections.get(k)
                    if pr.label == "1.27 AB=CD" and pr.in_prz
                        abcd_conv := true
                        break
                if prz.confluence_count < i_min_conf
                    any_rej_confluence := true
                else
                    float sc = f_score_alt_bat(a_rAB, a_rXD, prz, abcd_conv)
                    bool eligible = sc >= i_min_score or (i_show_borderline and sc >= i_borderline_min_score)
                    if not eligible
                        any_rej_score := true
                    else if sc > winner_score
                        winner_type  := "Alt Bat"
                        winner_state := sc >= i_min_score ? "Confirmed" : "Borderline"
                        winner_score := sc
                        winner_prz   := prz
                        winner_abcd  := abcd_conv
                        winner_bull  := a_bullish
                        winner_rAB   := a_rAB
                        winner_rBC   := a_rBC
                        winner_rCD   := a_rCD
                        winner_rXD   := a_rXD
                        winner_conf_count := prz.confluence_count

            // Butterfly candidate
            if bf_status == 0
                PRZ prz = f_build_butterfly_prz(pX, pA, pB, pC, bf_bullish)
                bool abcd_conv = false
                for k = 0 to prz.projections.size() - 1
                    Projection pr = prz.projections.get(k)
                    if pr.label == "1.27 AB=CD" and pr.in_prz
                        abcd_conv := true
                        break
                if prz.confluence_count < i_min_conf
                    any_rej_confluence := true
                else
                    float sc = f_score_butterfly(bf_rAB, bf_rXD, prz, abcd_conv)
                    bool eligible = sc >= i_min_score or (i_show_borderline and sc >= i_borderline_min_score)
                    if not eligible
                        any_rej_score := true
                    else if sc > winner_score
                        winner_type  := "Butterfly"
                        winner_state := sc >= i_min_score ? "Confirmed" : "Borderline"
                        winner_score := sc
                        winner_prz   := prz
                        winner_abcd  := abcd_conv
                        winner_bull  := bf_bullish
                        winner_rAB   := bf_rAB
                        winner_rBC   := bf_rBC
                        winner_rCD   := bf_rCD
                        winner_rXD   := bf_rXD
                        winner_conf_count := prz.confluence_count

            // Crab candidate
            if cr_status == 0
                PRZ prz = f_build_crab_prz(pX, pA, pB, pC, cr_bullish)
                bool abcd_conv = false
                for k = 0 to prz.projections.size() - 1
                    Projection pr = prz.projections.get(k)
                    if pr.label == "1.27 AB=CD" and pr.in_prz
                        abcd_conv := true
                        break
                if prz.confluence_count < i_min_conf
                    any_rej_confluence := true
                else
                    float sc = f_score_crab(cr_rAB, cr_rXD, prz, abcd_conv)
                    bool eligible = sc >= i_min_score or (i_show_borderline and sc >= i_borderline_min_score)
                    if not eligible
                        any_rej_score := true
                    else if sc > winner_score
                        winner_type  := "Crab"
                        winner_state := sc >= i_min_score ? "Confirmed" : "Borderline"
                        winner_score := sc
                        winner_prz   := prz
                        winner_abcd  := abcd_conv
                        winner_bull  := cr_bullish
                        winner_rAB   := cr_rAB
                        winner_rBC   := cr_rBC
                        winner_rCD   := cr_rCD
                        winner_rXD   := cr_rXD
                        winner_conf_count := prz.confluence_count

            // Deep Crab candidate (shares PRZ with Crab)
            if dc_status == 0
                PRZ prz = f_build_crab_prz(pX, pA, pB, pC, dc_bullish)
                bool abcd_conv = false
                for k = 0 to prz.projections.size() - 1
                    Projection pr = prz.projections.get(k)
                    if pr.label == "1.27 AB=CD" and pr.in_prz
                        abcd_conv := true
                        break
                if prz.confluence_count < i_min_conf
                    any_rej_confluence := true
                else
                    float sc = f_score_deep_crab(dc_rAB, dc_rXD, prz, abcd_conv)
                    bool eligible = sc >= i_min_score or (i_show_borderline and sc >= i_borderline_min_score)
                    if not eligible
                        any_rej_score := true
                    else if sc > winner_score
                        winner_type  := "Deep Crab"
                        winner_state := sc >= i_min_score ? "Confirmed" : "Borderline"
                        winner_score := sc
                        winner_prz   := prz
                        winner_abcd  := abcd_conv
                        winner_bull  := dc_bullish
                        winner_rAB   := dc_rAB
                        winner_rBC   := dc_rBC
                        winner_rCD   := dc_rCD
                        winner_rXD   := dc_rXD
                        winner_conf_count := prz.confluence_count

            // ── Resolve winner or track gate rejection ────────────────────
            if winner_type != ""
                bool is_confirmed_winner = winner_state == "Confirmed"

                if is_confirmed_winner
                    diag_accepted := diag_accepted + 1
                    if winner_type == "Gartley"
                        diag_accepted_gart := diag_accepted_gart + 1
                    else if winner_type == "Bat"
                        diag_accepted_bat := diag_accepted_bat + 1
                    else if winner_type == "Alt Bat"
                        diag_accepted_abat := diag_accepted_abat + 1
                    else if winner_type == "Butterfly"
                        diag_accepted_bfly := diag_accepted_bfly + 1
                    else if winner_type == "Crab"
                        diag_accepted_crab := diag_accepted_crab + 1
                    else if winner_type == "Deep Crab"
                        diag_accepted_dcrab := diag_accepted_dcrab + 1
                else
                    // Borderline patterns get their own counter, not mixed with confirmed
                    diag_accepted_borderline := diag_accepted_borderline + 1

                HarmonicPattern pat = HarmonicPattern.new(
                     pattern_type   = winner_type,
                     is_bullish     = winner_bull,
                     pX = pX, pA = pA, pB = pB, pC = pC, pD = pD,
                     prz            = winner_prz,
                     score          = winner_score,
                     abcd_converges = winner_abcd,
                     state          = winner_state,
                     r_AB = winner_rAB, r_BC = winner_rBC, r_CD = winner_rCD, r_XD = winner_rXD,
                     lines  = array.new<line>(0),
                     labels = array.new<label>(0),
                     boxes  = array.new<box>(0))

                HarmonicPattern drawn = f_draw_pattern(pat)
                patterns_active.push(drawn)

                // ── Alerts and fired-flags fire ONLY for confirmed patterns ────
                // Borderline patterns are educational/confluence display only.
                if is_confirmed_winner
                    // ── Set fired flag for the matching alertcondition ─────────
                    if winner_type == "Gartley"
                        if winner_bull
                            fired_gartley_bull := true
                        else
                            fired_gartley_bear := true
                    else if winner_type == "Bat"
                        if winner_bull
                            fired_bat_bull := true
                        else
                            fired_bat_bear := true
                    else if winner_type == "Alt Bat"
                        if winner_bull
                            fired_abat_bull := true
                        else
                            fired_abat_bear := true
                    else if winner_type == "Butterfly"
                        if winner_bull
                            fired_bfly_bull := true
                        else
                            fired_bfly_bear := true
                    else if winner_type == "Crab"
                        if winner_bull
                            fired_crab_bull := true
                        else
                            fired_crab_bear := true
                    else if winner_type == "Deep Crab"
                        if winner_bull
                            fired_dcrab_bull := true
                        else
                            fired_dcrab_bear := true

                    // ── Unified alert() with JSON payload ──────────────────────
                    // Fires once per bar close per pattern that meets min_score.
                    // Payload format: keys quoted, all values JSON-safe.
                    if i_enable_alerts and winner_score >= i_alert_min_score
                        string direction = winner_bull ? "bullish" : "bearish"
                        string abcd_str  = winner_abcd ? "true" : "false"
                        string msg = "{" +
                             "\"ticker\":\"" + syminfo.ticker + "\"," +
                             "\"tf\":\"" + timeframe.period + "\"," +
                             "\"pattern\":\"" + winner_type + "\"," +
                             "\"direction\":\"" + direction + "\"," +
                             "\"score\":" + str.tostring(winner_score, "#.#") + "," +
                             "\"abcd_converges\":" + abcd_str + "," +
                             "\"prz_top\":" + str.tostring(winner_prz.top) + "," +
                             "\"prz_bot\":" + str.tostring(winner_prz.bot) + "," +
                             "\"r_AB\":" + str.tostring(winner_rAB, "#.###") + "," +
                             "\"r_BC\":" + str.tostring(winner_rBC, "#.###") + "," +
                             "\"r_CD\":" + str.tostring(winner_rCD, "#.###") + "," +
                             "\"r_XD\":" + str.tostring(winner_rXD, "#.###") + "," +
                             "\"x_p\":" + str.tostring(pX.price) + ",\"x_t\":" + str.tostring(pX.t) + "," +
                             "\"a_p\":" + str.tostring(pA.price) + ",\"a_t\":" + str.tostring(pA.t) + "," +
                             "\"b_p\":" + str.tostring(pB.price) + ",\"b_t\":" + str.tostring(pB.t) + "," +
                             "\"c_p\":" + str.tostring(pC.price) + ",\"c_t\":" + str.tostring(pC.t) + "," +
                             "\"d_p\":" + str.tostring(pD.price) + ",\"d_t\":" + str.tostring(pD.t) + "," +
                             "\"time_fired\":" + str.tostring(time) +
                             "}"
                        alert(msg, alert.freq_once_per_bar_close)
            else if any_rej_score
                diag_rej_score := diag_rej_score + 1
            else if any_rej_confluence
                diag_rej_confluence := diag_rej_confluence + 1


// ═══════════════════════════════════════════════════════════════════════════════
//  FORMING MODE LIFECYCLE
// ═══════════════════════════════════════════════════════════════════════════════
//
//  Three blocks of logic, all gated on i_show_forming:
//
//  1. Lifecycle transitions: when a new pivot prints, check if it completes
//     any existing forming pattern (Forming → Confirmed) or invalidates it
//     (Forming → Failed).
//
//  2. Forming scan loop: identify new forming patterns from windows where the
//     most recent pivot is C (i.e., XABC complete, D not yet printed).
//
//  3. Decay: clean up stale forming patterns (time/distance) and faded failed
//     patterns. Runs every bar.
//
// ═══════════════════════════════════════════════════════════════════════════════

if i_show_forming and new_pivot_added and pivot_buf.size() >= 1
    // ── Block 1: Lifecycle transitions ─────────────────────────────────────────
    // For each existing forming pattern, check if a pivot newer than C now
    // exists. If yes, that pivot was the candidate D. Either:
    //   - The confirmed scan loop above already created a confirmed/borderline
    //     pattern with same XABC → delete the forming pattern (it was promoted).
    //   - No confirmed pattern was created → forming → Failed.
    int idx = 0
    while idx < patterns_active.size()
        HarmonicPattern p = patterns_active.get(idx)
        bool advance = true
        if p.state == "Forming"
            // Check if any pivot in buffer is newer than this forming pattern's C
            bool has_newer_pivot = false
            for k = 0 to pivot_buf.size() - 1
                if pivot_buf.get(k).bi > p.pC.bi
                    has_newer_pivot := true
                    break

            if has_newer_pivot
                // Search for a confirmed pattern with same X.t and C.t
                bool was_promoted = false
                for j = 0 to patterns_active.size() - 1
                    HarmonicPattern other = patterns_active.get(j)
                    if other.state != "Forming" and other.state != "Failed" and
                       other.pX.t == p.pX.t and other.pC.t == p.pC.t
                        was_promoted := true
                        break

                if was_promoted
                    // Forming → Confirmed (or Borderline). Delete forming drawings.
                    if not na(p.lines)
                        while p.lines.size() > 0
                            line.delete(p.lines.shift())
                    if not na(p.labels)
                        while p.labels.size() > 0
                            label.delete(p.labels.shift())
                    if not na(p.boxes)
                        while p.boxes.size() > 0
                            box.delete(p.boxes.shift())
                    patterns_active.remove(idx)
                    diag_forming_to_confirmed := diag_forming_to_confirmed + 1
                    advance := false
                else
                    // Forming → Failed. Update state, redraw with failed visual.
                    if i_show_failed
                        // Find candidate D (the first pivot newer than C)
                        Pivot candidate_d = na
                        for k = 0 to pivot_buf.size() - 1
                            if pivot_buf.get(k).bi > p.pC.bi
                                candidate_d := pivot_buf.get(k)
                                break

                        // Delete current forming drawings
                        if not na(p.lines)
                            while p.lines.size() > 0
                                line.delete(p.lines.shift())
                        if not na(p.labels)
                            while p.labels.size() > 0
                                label.delete(p.labels.shift())
                        if not na(p.boxes)
                            while p.boxes.size() > 0
                                box.delete(p.boxes.shift())

                        // Update pattern to Failed state
                        p.pD := candidate_d
                        p.state := "Failed"
                        p.failed_at_bar := bar_index
                        // Redraw with failed visual treatment
                        HarmonicPattern redrawn = f_draw_pattern(p)
                        patterns_active.set(idx, redrawn)
                    else
                        // i_show_failed off — just delete the forming pattern silently
                        if not na(p.lines)
                            while p.lines.size() > 0
                                line.delete(p.lines.shift())
                        if not na(p.labels)
                            while p.labels.size() > 0
                                label.delete(p.labels.shift())
                        if not na(p.boxes)
                            while p.boxes.size() > 0
                                box.delete(p.boxes.shift())
                        patterns_active.remove(idx)
                        advance := false
                    diag_forming_to_failed := diag_forming_to_failed + 1
        if advance
            idx := idx + 1


// ── Block 2: Forming scan loop ────────────────────────────────────────────────
// Iterate 4-pivot windows to identify XABC patterns where D doesn't yet exist.
// Only consider windows where C is the MOST RECENT pivot in the buffer (so
// no candidate D pivot exists yet — otherwise the lifecycle block above would
// handle the transition).
if i_show_forming and new_pivot_added and pivot_buf.size() >= 4
    int last_idx = pivot_buf.size() - 1
    Pivot pX = pivot_buf.get(last_idx - 3)
    Pivot pA = pivot_buf.get(last_idx - 2)
    Pivot pB = pivot_buf.get(last_idx - 1)
    Pivot pC = pivot_buf.get(last_idx)

    // Dedupe: skip if any pattern with this XABC already exists
    bool dup = false
    if patterns_active.size() > 0
        for j = 0 to patterns_active.size() - 1
            HarmonicPattern ex = patterns_active.get(j)
            if ex.pX.t == pX.t and ex.pC.t == pC.t
                dup := true
                break

    if not dup
        // Run all enabled forming validators
        int   gf_status = -1
        bool  gf_bull   = false
        float gf_rAB    = 0.0
        float gf_rBC    = 0.0
        if i_scan_gartley
            [s, b, ab, bc] = f_validate_gartley_forming(pX, pA, pB, pC)
            gf_status := s
            gf_bull := b
            gf_rAB := ab
            gf_rBC := bc

        int   bf_status = -1
        bool  bf_bull   = false
        float bf_rAB    = 0.0
        float bf_rBC    = 0.0
        if i_scan_bat
            [s, b, ab, bc] = f_validate_bat_forming(pX, pA, pB, pC)
            bf_status := s
            bf_bull := b
            bf_rAB := ab
            bf_rBC := bc

        int   af_status = -1
        bool  af_bull   = false
        float af_rAB    = 0.0
        float af_rBC    = 0.0
        if i_scan_alt_bat
            [s, b, ab, bc] = f_validate_alt_bat_forming(pX, pA, pB, pC)
            af_status := s
            af_bull := b
            af_rAB := ab
            af_rBC := bc

        int   bff_status = -1
        bool  bff_bull   = false
        float bff_rAB    = 0.0
        float bff_rBC    = 0.0
        if i_scan_butterfly
            [s, b, ab, bc] = f_validate_butterfly_forming(pX, pA, pB, pC)
            bff_status := s
            bff_bull := b
            bff_rAB := ab
            bff_rBC := bc

        int   cf_status = -1
        bool  cf_bull   = false
        float cf_rAB    = 0.0
        float cf_rBC    = 0.0
        if i_scan_crab
            [s, b, ab, bc] = f_validate_crab_forming(pX, pA, pB, pC)
            cf_status := s
            cf_bull := b
            cf_rAB := ab
            cf_rBC := bc

        int   df_status = -1
        bool  df_bull   = false
        float df_rAB    = 0.0
        float df_rBC    = 0.0
        if i_scan_deep_crab
            [s, b, ab, bc] = f_validate_deep_crab_forming(pX, pA, pB, pC)
            df_status := s
            df_bull := b
            df_rAB := ab
            df_rBC := bc

        // Build PRZ + score for each successful validator. Highest score wins.
        string fwinner_type  = ""
        float  fwinner_score = -1.0
        PRZ    fwinner_prz   = na
        bool   fwinner_bull  = false
        float  fwinner_rAB   = 0.0
        float  fwinner_rBC   = 0.0

        if gf_status == 0
            PRZ prz = f_build_gartley_prz(pX, pA, pB, pC, gf_bull)
            if prz.confluence_count >= i_min_conf
                float sc = f_score_gartley_forming(gf_rAB, prz)
                if sc >= i_forming_min_score and sc > fwinner_score
                    fwinner_type  := "Gartley"
                    fwinner_score := sc
                    fwinner_prz   := prz
                    fwinner_bull  := gf_bull
                    fwinner_rAB   := gf_rAB
                    fwinner_rBC   := gf_rBC

        if bf_status == 0
            PRZ prz = f_build_bat_prz(pX, pA, pB, pC, bf_bull)
            if prz.confluence_count >= i_min_conf
                float sc = f_score_bat_forming(bf_rAB, prz)
                if sc >= i_forming_min_score and sc > fwinner_score
                    fwinner_type  := "Bat"
                    fwinner_score := sc
                    fwinner_prz   := prz
                    fwinner_bull  := bf_bull
                    fwinner_rAB   := bf_rAB
                    fwinner_rBC   := bf_rBC

        if af_status == 0
            PRZ prz = f_build_alt_bat_prz(pX, pA, pB, pC, af_bull)
            if prz.confluence_count >= i_min_conf
                float sc = f_score_alt_bat_forming(af_rAB, prz)
                if sc >= i_forming_min_score and sc > fwinner_score
                    fwinner_type  := "Alt Bat"
                    fwinner_score := sc
                    fwinner_prz   := prz
                    fwinner_bull  := af_bull
                    fwinner_rAB   := af_rAB
                    fwinner_rBC   := af_rBC

        if bff_status == 0
            PRZ prz = f_build_butterfly_prz(pX, pA, pB, pC, bff_bull)
            if prz.confluence_count >= i_min_conf
                float sc = f_score_butterfly_forming(bff_rAB, prz)
                if sc >= i_forming_min_score and sc > fwinner_score
                    fwinner_type  := "Butterfly"
                    fwinner_score := sc
                    fwinner_prz   := prz
                    fwinner_bull  := bff_bull
                    fwinner_rAB   := bff_rAB
                    fwinner_rBC   := bff_rBC

        if cf_status == 0
            PRZ prz = f_build_crab_prz(pX, pA, pB, pC, cf_bull)
            if prz.confluence_count >= i_min_conf
                float sc = f_score_crab_forming(cf_rAB, prz)
                if sc >= i_forming_min_score and sc > fwinner_score
                    fwinner_type  := "Crab"
                    fwinner_score := sc
                    fwinner_prz   := prz
                    fwinner_bull  := cf_bull
                    fwinner_rAB   := cf_rAB
                    fwinner_rBC   := cf_rBC

        if df_status == 0
            PRZ prz = f_build_crab_prz(pX, pA, pB, pC, df_bull)  // shares PRZ with Crab
            if prz.confluence_count >= i_min_conf
                float sc = f_score_deep_crab_forming(df_rAB, prz)
                if sc >= i_forming_min_score and sc > fwinner_score
                    fwinner_type  := "Deep Crab"
                    fwinner_score := sc
                    fwinner_prz   := prz
                    fwinner_bull  := df_bull
                    fwinner_rAB   := df_rAB
                    fwinner_rBC   := df_rBC

        // If any forming validator yielded a score, create the pattern
        if fwinner_type != ""
            HarmonicPattern fpat = HarmonicPattern.new(
                 pattern_type   = fwinner_type,
                 is_bullish     = fwinner_bull,
                 pX = pX, pA = pA, pB = pB, pC = pC,
                 pD = na,
                 prz            = fwinner_prz,
                 score          = fwinner_score,
                 abcd_converges = false,    // Unknown for forming
                 state          = "Forming",
                 r_AB = fwinner_rAB, r_BC = fwinner_rBC, r_CD = 0.0, r_XD = 0.0,
                 forming_c_bar  = pC.bi,
                 failed_at_bar  = 0,
                 lines  = array.new<line>(0),
                 labels = array.new<label>(0),
                 boxes  = array.new<box>(0))

            HarmonicPattern fdrawn = f_draw_pattern(fpat)
            patterns_active.push(fdrawn)


// ── Block 3: Decay (runs every bar, not just on new pivots) ───────────────────
// Time-decay: forming patterns auto-delete after N bars without D.
// Distance-decay: forming patterns auto-delete if price moves too far in wrong direction.
// Failed-fadeout: failed patterns delete after length_eff bars.
if i_show_forming
    int forming_max = i_forming_max_bars > 0 ? i_forming_max_bars : length_eff * 5
    int didx = 0
    while didx < patterns_active.size()
        HarmonicPattern p = patterns_active.get(didx)
        bool advance = true

        if p.state == "Forming"
            // Time decay
            bool stale_time = bar_index - p.forming_c_bar > forming_max

            // Distance decay: price moved too far in wrong direction from C
            float dist_threshold = i_forming_max_atr * atr_v
            bool stale_dist = false
            if p.is_bullish
                // Bullish pattern expects price DOWN to PRZ; UP-move beyond C invalidates
                stale_dist := close > p.pC.price + dist_threshold
            else
                // Bearish pattern expects price UP to PRZ; DOWN-move beyond C invalidates
                stale_dist := close < p.pC.price - dist_threshold

            if stale_time or stale_dist
                if not na(p.lines)
                    while p.lines.size() > 0
                        line.delete(p.lines.shift())
                if not na(p.labels)
                    while p.labels.size() > 0
                        label.delete(p.labels.shift())
                if not na(p.boxes)
                    while p.boxes.size() > 0
                        box.delete(p.boxes.shift())
                patterns_active.remove(didx)
                diag_forming_to_stale := diag_forming_to_stale + 1
                advance := false

        else if p.state == "Failed"
            // Fade-out: remove failed pattern after length_eff bars
            if bar_index - p.failed_at_bar > length_eff
                if not na(p.lines)
                    while p.lines.size() > 0
                        line.delete(p.lines.shift())
                if not na(p.labels)
                    while p.labels.size() > 0
                        label.delete(p.labels.shift())
                if not na(p.boxes)
                    while p.boxes.size() > 0
                        box.delete(p.boxes.shift())
                patterns_active.remove(didx)
                advance := false

        if advance
            didx := didx + 1

// Recalculate active forming count (used by diagnostics table)
diag_forming_active := 0
if patterns_active.size() > 0
    for k = 0 to patterns_active.size() - 1
        if patterns_active.get(k).state == "Forming"
            diag_forming_active := diag_forming_active + 1


// ── Cap array size (FIFO eviction + cleanup of drawing objects) ────────────────
while patterns_active.size() > i_max_active
    HarmonicPattern old = patterns_active.shift()
    if not na(old.lines)
        while old.lines.size() > 0
            line.delete(old.lines.shift())
    if not na(old.labels)
        while old.labels.size() > 0
            label.delete(old.labels.shift())
    if not na(old.boxes)
        while old.boxes.size() > 0
            box.delete(old.boxes.shift())


// ═══════════════════════════════════════════════════════════════════════════════
//  PIVOT MARKERS  (optional — controlled by Show Pivot Markers toggle)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  These triangle markers visualize ALL detected pivots — not just those
//  in confirmed patterns. Useful for understanding the zigzag the indicator
//  uses internally, and for spotting "near miss" patterns where one pivot
//  fell outside a tolerance band. Toggle off in the Display group if cluttered.
//
// ═══════════════════════════════════════════════════════════════════════════════

plotshape(i_show_pivot_markers and not na(piv_h), "Pivot High", shape.triangledown, location.abovebar,
     color = color.new(color.gray, 30),
     size  = size.tiny,
     offset = -length_eff)

plotshape(i_show_pivot_markers and not na(piv_l), "Pivot Low", shape.triangleup, location.belowbar,
     color = color.new(color.gray, 30),
     size  = size.tiny,
     offset = -length_eff)

// ── Diagnostics table (gated on i_show_diagnostics) ───────────────────────────
// Renders detection statistics in the top-right corner. Off by default.
// Table is allocated for 29 rows (max size when distribution stats are shown).
// When distribution toggle is OFF, rows 24-28 simply remain empty — no visible
// gap because Pine collapses cell-less rows to zero height.
var table dbg = table.new(position.top_right, 2, 33, border_width=1)
if barstate.islast and i_show_diagnostics
    color h_bg = color.new(color.navy, 70)
    color c_bg = color.new(color.gray, 80)
    color d_bg = color.new(color.purple, 70)
    color w    = color.white

    table.cell(dbg, 0,  0, "HAV Diagnostics", bgcolor=h_bg, text_color=w)
    table.cell(dbg, 1,  0, "",              bgcolor=h_bg, text_color=w)

    table.cell(dbg, 0,  1, "Length (eff)",  bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  1, str.tostring(length_eff), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0,  2, "Log Scale",     bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  2, use_log ? "ON" : "OFF", bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0,  3, "Preset",        bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  3, i_preset,        bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0,  4, "Pivot Buffer",  bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  4, str.tostring(pivot_buf.size()) + " / 12", bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0,  5, "ATR(" + str.tostring(i_atr_period) + ")", bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  5, str.tostring(atr_v, "#.##"), bgcolor=c_bg, text_color=w)

    // ── Rejection counters ─────────────────────────────────────────────
    table.cell(dbg, 0,  6, "── Gartley Diagnostics ──", bgcolor=h_bg, text_color=w)
    table.cell(dbg, 1,  6, "",              bgcolor=h_bg, text_color=w)

    table.cell(dbg, 0,  7, "Windows Tested", bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  7, str.tostring(diag_windows_tested), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0,  8, "G-Rej: direction",  bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  8, str.tostring(diag_rej_direction), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0,  9, "G-Rej: structure",  bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1,  9, str.tostring(diag_rej_structure), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 10, "G-Rej: XA small",   bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 10, str.tostring(diag_rej_xa_small), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 11, "G-Rej: AB band",    bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 11, str.tostring(diag_rej_ab), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 12, "G-Rej: BC band",    bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 12, str.tostring(diag_rej_bc), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 13, "G-Rej: CD band",    bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 13, str.tostring(diag_rej_cd), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 14, "G-Rej: D band",     bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 14, str.tostring(diag_rej_d), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 15, "Rej: confluence/score", bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 15, str.tostring(diag_rej_confluence) + " / " + str.tostring(diag_rej_score), bgcolor=c_bg, text_color=w)

    // ── Per-pattern acceptance breakdown ───────────────────────────────
    color acc_bg = color.new(color.green, 60)
    table.cell(dbg, 0, 16, "Accepted (total)",  bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 16, str.tostring(diag_accepted), bgcolor=acc_bg, text_color=w)

    table.cell(dbg, 0, 17, "  ├ Gartley",       bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 17, str.tostring(diag_accepted_gart), bgcolor=acc_bg, text_color=w)

    table.cell(dbg, 0, 18, "  ├ Bat",           bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 18, str.tostring(diag_accepted_bat), bgcolor=acc_bg, text_color=w)

    table.cell(dbg, 0, 19, "  ├ Alt Bat",       bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 19, str.tostring(diag_accepted_abat), bgcolor=acc_bg, text_color=w)

    table.cell(dbg, 0, 20, "  ├ Butterfly",     bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 20, str.tostring(diag_accepted_bfly), bgcolor=acc_bg, text_color=w)

    table.cell(dbg, 0, 21, "  ├ Crab",          bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 21, str.tostring(diag_accepted_crab), bgcolor=acc_bg, text_color=w)

    table.cell(dbg, 0, 22, "  └ Deep Crab",     bgcolor=acc_bg, text_color=w)
    table.cell(dbg, 1, 22, str.tostring(diag_accepted_dcrab), bgcolor=acc_bg, text_color=w)

    color bord_bg = color.new(color.gray, 60)
    table.cell(dbg, 0, 23, "Borderline (any)", bgcolor=bord_bg, text_color=w)
    table.cell(dbg, 1, 23, str.tostring(diag_accepted_borderline), bgcolor=bord_bg, text_color=w)

    // ── Forming-mode lifecycle counters (only meaningful when forming is on) ──
    color form_bg = color.new(color.purple, 75)
    table.cell(dbg, 0, 24, i_show_forming ? "── Forming Lifecycle ──" : "── Forming (off) ──",
         bgcolor=form_bg, text_color=w)
    table.cell(dbg, 1, 24, "", bgcolor=form_bg, text_color=w)

    table.cell(dbg, 0, 25, "Forming (active)", bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 25, str.tostring(diag_forming_active), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 26, "Forming → Confirmed", bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 26, str.tostring(diag_forming_to_confirmed), bgcolor=c_bg, text_color=w)

    table.cell(dbg, 0, 27, "Forming → Failed/Stale",  bgcolor=c_bg, text_color=w)
    table.cell(dbg, 1, 27, str.tostring(diag_forming_to_failed) + " / " + str.tostring(diag_forming_to_stale),
         bgcolor=c_bg, text_color=w)

    // ── Ratio distribution for structure-passing candidates (gated on toggle) ──
    if i_show_distribution
        table.cell(dbg, 0, 28, "── Distribution ──", bgcolor=d_bg, text_color=w)
        table.cell(dbg, 1, 28, "",              bgcolor=d_bg, text_color=w)

        string ab_stats = diag_ab_count == 0 ? "n/a" :
             "min " + str.tostring(diag_ab_min, "#.###") + 
             " / avg " + str.tostring(diag_ab_sum / diag_ab_count, "#.###") + 
             " / max " + str.tostring(diag_ab_max, "#.###")
        table.cell(dbg, 0, 29, "r_AB (ideal 0.618)", bgcolor=c_bg, text_color=w)
        table.cell(dbg, 1, 29, ab_stats,         bgcolor=c_bg, text_color=w, text_size=size.tiny)

        string xd_stats = diag_xd_count == 0 ? "n/a" :
             "min " + str.tostring(diag_xd_min, "#.###") + 
             " / avg " + str.tostring(diag_xd_sum / diag_xd_count, "#.###") + 
             " / max " + str.tostring(diag_xd_max, "#.###")
        table.cell(dbg, 0, 30, "r_XD (ideal 0.786)", bgcolor=c_bg, text_color=w)
        table.cell(dbg, 1, 30, xd_stats,         bgcolor=c_bg, text_color=w, text_size=size.tiny)

        table.cell(dbg, 0, 31, "Samples (struct+XA passed)", bgcolor=c_bg, text_color=w)
        table.cell(dbg, 1, 31, str.tostring(diag_ab_count), bgcolor=c_bg, text_color=w)

        string best_stats = diag_ab_count == 0 ? "n/a" :
             "AB=" + str.tostring(diag_ab_best_val, "#.###") + 
             " (Δ " + str.tostring(math.abs(diag_ab_best_val - 0.618), "#.###") + ")  " +
             "XD=" + str.tostring(diag_xd_best_val, "#.###") + 
             " (Δ " + str.tostring(math.abs(diag_xd_best_val - 0.786), "#.###") + ")"
        table.cell(dbg, 0, 32, "Closest to ideal", bgcolor=color.new(color.orange, 70), text_color=w)
        table.cell(dbg, 1, 32, best_stats, bgcolor=color.new(color.orange, 70), text_color=w, text_size=size.tiny)
    else
        // When toggle is off, explicitly clear distribution rows in case they
        // were previously populated (handles runtime toggle without script reload).
        for clr_row = 28 to 32
            table.cell(dbg, 0, clr_row, "", bgcolor=color.new(color.white, 100))
            table.cell(dbg, 1, clr_row, "", bgcolor=color.new(color.white, 100))

// ═══════════════════════════════════════════════════════════════════════════════
//  ALERT CONDITIONS  (12 named alertcondition() — bullish/bearish × 6 patterns)
// ═══════════════════════════════════════════════════════════════════════════════
//
//  These give users selective subscription via TradingView's standard alert UI.
//  The unified alert() call above fires regardless of these (when enabled), but
//  these let a user pick "only Bat bullish" or "only Crab bearish" directly in
//  the alert creation dialog without webhook/JSON parsing infrastructure.
//
//  Each alertcondition() is constant-time evaluated by Pine on every bar close.
//  Message strings are kept short — users can customize them in the alert UI.
//
// ═══════════════════════════════════════════════════════════════════════════════

alertcondition(fired_gartley_bull, title="Gartley bullish",
